rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function realUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email != null;
    }
    function userEmail() { return request.auth.token.email.lower(); }

    function isMember() {
      return realUser()
        && exists(/databases/$(database)/documents/members/$(userEmail()))
        && get(/databases/$(database)/documents/members/$(userEmail())).data.active == true;
    }

    // v28.1: المدير الموقوف أو المحذوف (عضويته active=false) يفقد صفة المدير حتى لو بقي بريده في القائمة.
    // غياب العضوية كليًا مسموح فقط لتمهيد أول مالك قبل إنشاء عضويته.
    function isAdmin() {
      return realUser()
        && exists(/databases/$(database)/documents/platform/admins)
        && (userEmail() in get(/databases/$(database)/documents/platform/admins).data.emails)
        && (!exists(/databases/$(database)/documents/members/$(userEmail()))
            || get(/databases/$(database)/documents/members/$(userEmail())).data.active == true);
    }

    function memberData() {
      return get(/databases/$(database)/documents/members/$(userEmail())).data;
    }

    function isCentral() {
      return isMember() && ('scope' in memberData()) && memberData().scope == 'all';
    }
    function myBranchId() {
      return (isMember() && ('branchId' in memberData())) ? memberData().branchId : '';
    }
    function myBranchIds() {
      return (isMember() && ('branchIds' in memberData()) && memberData().branchIds is list)
        ? memberData().branchIds : [];
    }
    function canBranch(bId) {
      return isAdmin() || isCentral() || myBranchId() == bId || (bId in myBranchIds());
    }

    function baseId(id) { return id.split('__')[0]; }

    function isOrgDoc(id)    { return baseId(id).matches('^rms8_org.*$'); }
    function isCoreDoc(id)   { return baseId(id) == 'rms8_core'; }
    function isBrDoc(id)     { return baseId(id).matches('^rms8_br_.+$'); }
    function isBfDoc(id)     { return baseId(id).matches('^rms8_bf_.+$'); }
    function isBranchDoc(id) { return isBrDoc(id) || isBfDoc(id); }

    function branchIdOf(id) {
      return isBrDoc(id) ? baseId(id).split('rms8_br_')[1] : baseId(id).split('rms8_bf_')[1];
    }

    function pulseAuditSafe() {
      return isAdmin()
        || !('audit' in resource.data)
        || !('audit' in request.resource.data)
        || request.resource.data.audit.size() >= resource.data.audit.size();
    }

    match /platform/admins {
      allow read: if realUser();
      allow create: if realUser() && request.resource.data.emails == [userEmail()];
      allow update, delete: if isAdmin();
    }

    match /members/{memberEmail} {
      allow read: if isAdmin() || (realUser() && userEmail() == memberEmail);
      allow write: if isAdmin();
    }

    // v28.1: قائمة سماح صريحة لأسماء المستندات — أي اسم آخر مرفوض قراءةً وكتابةً
    function knownDoc(id) {
      return baseId(id) in ['rms8_org', 'rms8_dir', 'rms8_core', 'rms8_pulse', 'rms8_ops', 'rms8_files', 'rms8_hist']
        || isBranchDoc(id);
    }
    // المستندات القديمة (تشغيل ما قبل v9، أرشيف الملفات القديم، الإغلاقات المؤرشفة) تضم بيانات كل الفروع
    function isLegacyDoc(id) { return baseId(id) in ['rms8_ops', 'rms8_files', 'rms8_hist']; }
    function isChunkDoc(id)  { return id.matches('^.+__[0-9]{1,3}$'); }
    // شكل ما تكتبه طبقة التخزين فقط: رأس {parts, updatedAt, value} بسقف 500 جزء، أو جزء {chunk}
    function validShape(id) {
      return isChunkDoc(id)
        ? request.resource.data.keys().hasOnly(['chunk']) && request.resource.data.chunk is string
        : request.resource.data.keys().hasOnly(['parts', 'updatedAt', 'value'])
          && request.resource.data.parts is int
          && request.resource.data.parts >= 1 && request.resource.data.parts <= 500
          && request.resource.data.value is string;
    }

    match /platform/{docId} {
      allow read: if isMember()
        && knownDoc(docId)
        && (!isOrgDoc(docId)    || isCentral() || isAdmin())
        && (!isCoreDoc(docId)   || isCentral() || isAdmin())
        && (!isLegacyDoc(docId) || isCentral() || isAdmin())
        && (!isBranchDoc(docId) || canBranch(branchIdOf(docId)));

      allow write: if isMember()
        && docId != 'admins'
        && knownDoc(docId)
        && validShape(docId)
        && (!isOrgDoc(docId)    || isAdmin())
        && (!isCoreDoc(docId)   || isCentral() || isAdmin())
        && (!isLegacyDoc(docId) || isCentral() || isAdmin())
        && (!isBranchDoc(docId) || canBranch(branchIdOf(docId)))
        && (baseId(docId) != 'rms8_dir' || isAdmin())
        && (baseId(docId) != 'rms8_pulse' || pulseAuditSafe());
    }
    /* ===== v28.0 — وحدة تقييم العملاء بالـ QR ===== */
    function validRating(v) { return v is int && v >= 1 && v <= 5; }
    function shortOrNull(v) { return v == null || (v is string && v.size() <= 20); }
    function qrBranchOpen(bId) {
      return bId is string && bId.matches('^[A-Za-z0-9_-]{1,80}$')
        && exists(/databases/$(database)/documents/qr_branches/$(bId))
        && get(/databases/$(database)/documents/qr_branches/$(bId)).data.active == true;
    }

    match /qr_branches/{branchId} {
      allow read: if true;
      allow create, update: if isMember() && (isAdmin() || isCentral())
        && request.resource.data.keys().hasOnly(['name', 'company', 'active', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    match /qr_feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['branchId', 'ratings', 'comment', 'tableNo', 'invoiceNo', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['branchId', 'ratings', 'comment', 'tableNo', 'invoiceNo', 'source', 'createdAt'])
        && qrBranchOpen(request.resource.data.branchId)
        && request.resource.data.ratings is map
        && request.resource.data.ratings.keys().hasOnly(['quality', 'taste', 'temp', 'size', 'staff', 'speed', 'pro', 'clean', 'vibe', 'comfort'])
        && request.resource.data.ratings.keys().hasAll(['quality', 'taste', 'temp', 'size', 'staff', 'speed', 'pro', 'clean', 'vibe', 'comfort'])
        && validRating(request.resource.data.ratings.quality)
        && validRating(request.resource.data.ratings.taste)
        && validRating(request.resource.data.ratings.temp)
        && validRating(request.resource.data.ratings.size)
        && validRating(request.resource.data.ratings.staff)
        && validRating(request.resource.data.ratings.speed)
        && validRating(request.resource.data.ratings.pro)
        && validRating(request.resource.data.ratings.clean)
        && validRating(request.resource.data.ratings.vibe)
        && validRating(request.resource.data.ratings.comfort)
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && shortOrNull(request.resource.data.tableNo)
        && shortOrNull(request.resource.data.invoiceNo)
        && request.resource.data.source == 'qr'
        && request.resource.data.createdAt == request.time;
      allow read: if isMember() && canBranch(resource.data.branchId);
      allow update: if isMember() && canBranch(resource.data.branchId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'resolvedAt', 'updatedAt', 'ai', 'aiError'])
        && (!('status' in request.resource.data) || request.resource.data.status in ['new', 'in_progress', 'resolved']);
      allow delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
