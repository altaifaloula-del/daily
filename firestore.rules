rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function realUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email != null;
    }
    function userEmail() { return request.auth.token.email.lower(); }

    function isMember() {
      return realUser()
        && exists(/databases/$(database)/documents/members/$(userEmail()))
        && get(/databases/$(database)/documents/members/$(userEmail())).data.active == true;
    }

    // v28.1: المدير الموقوف أو المحذوف (عضويته active=false) يفقد صفة المدير حتى لو بقي بريده في القائمة.
    // غياب العضوية كليًا مسموح فقط لتمهيد أول مالك قبل إنشاء عضويته.
    function isAdmin() {
      return realUser()
        && exists(/databases/$(database)/documents/platform/admins)
        && (userEmail() in get(/databases/$(database)/documents/platform/admins).data.emails)
        && (!exists(/databases/$(database)/documents/members/$(userEmail()))
            || get(/databases/$(database)/documents/members/$(userEmail())).data.active == true);
    }

    function memberData() {
      return get(/databases/$(database)/documents/members/$(userEmail())).data;
    }

    function isCentral() {
      return isMember() && ('scope' in memberData()) && memberData().scope == 'all';
    }
    function myBranchId() {
      return (isMember() && ('branchId' in memberData())) ? memberData().branchId : '';
    }
    function myBranchIds() {
      return (isMember() && ('branchIds' in memberData()) && memberData().branchIds is list)
        ? memberData().branchIds : [];
    }
    // v29.5: الأدوار للعرض فقط (accountant_view) تقرأ كل البيانات لكنها لا تكتب — كان المنع في الواجهة وحدها
    function readOnlyRole() {
      return isMember() && ('role' in memberData()) && memberData().role in ['accountant_view'];
    }
    function canBranch(bId) {
      return isAdmin() || isCentral() || myBranchId() == bId || (bId in myBranchIds());
    }

    // v31.3 — التحقق بخطوتين: سياسة platform/security {roles, admins} تُلزم أدوارًا محددة (والمدراء) بأن تكون الجلسة
    // قد اجتازت الخطوة الثانية (مطالبة sign_in_second_factor في رمز Firebase) — وإلا لا قراءة ولا كتابة لبيانات المنصة.
    function twoFactor() {
      return request.auth != null && ('firebase' in request.auth.token)
        && ('sign_in_second_factor' in request.auth.token.firebase);
    }
    function secPolicy() { return get(/databases/$(database)/documents/platform/security).data; }
    function myRoleIn(roles) {
      return exists(/databases/$(database)/documents/members/$(userEmail()))
        && ('role' in memberData()) && memberData().role in roles;
    }
    function mfaRequired() {
      return exists(/databases/$(database)/documents/platform/security)
        && ((secPolicy().get('admins', false) == true && isAdmin()) || myRoleIn(secPolicy().get('roles', [])));
    }
    function mfaOk() { return twoFactor() || !mfaRequired(); }

    function baseId(id) { return id.split('__')[0]; }

    function isOrgDoc(id)    { return baseId(id).matches('^rms8_org.*$'); }
    function isCoreDoc(id)   { return baseId(id) == 'rms8_core'; }
    function isBrDoc(id)     { return baseId(id).matches('^rms8_br_.+$'); }
    function isBfDoc(id)     { return baseId(id).matches('^rms8_bf_.+$'); }
    function isBranchDoc(id) { return isBrDoc(id) || isBfDoc(id); }

    function branchIdOf(id) {
      return isBrDoc(id) ? baseId(id).split('rms8_br_')[1] : baseId(id).split('rms8_bf_')[1];
    }

    // v40.0: أُزيلت pulseAuditSafe — كانت تفحص حقل «audit» في مستند محفوظ نصًا مضغوطًا فلا تراه أبدًا (تمر دائمًا).
    //        السجل انتقل إلى audit_log المحصّن أدناه، ومستند النبض للحضور فقط.

    match /platform/admins {
      // قائمة بريد المدراء لا تُكشف لأي حساب مسجّل: تُقرأ للأعضاء/المدراء فقط،
      // وغيابها (resource == null) يُقرأ لأي موثّق كي يعمل تمهيد أول مالك.
      allow read: if realUser() && (resource == null || isMember() || isAdmin());
      allow create: if realUser() && request.resource.data.emails == [userEmail()];
      allow update, delete: if isAdmin();
    }

    // السياسة يقرؤها كل عضو (لتعرض الواجهة ما يلزمه)، ويكتبها المدير فقط — ولا يُفعّلها على نفسه دون جلسة بخطوتين (منع قفل نفسه)
    match /platform/security {
      allow read: if isMember() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['roles', 'admins', 'at'])
        && request.resource.data.roles is list && request.resource.data.admins is bool
        && (twoFactor() || !(request.resource.data.admins == true || myRoleIn(request.resource.data.roles)));
      allow delete: if isAdmin() && twoFactor();
    }

    match /members/{memberEmail} {
      allow read: if isAdmin() || (realUser() && userEmail() == memberEmail);
      allow write: if isAdmin();
    }

    // v28.1: قائمة سماح صريحة لأسماء المستندات — أي اسم آخر مرفوض قراءةً وكتابةً
    function knownDoc(id) {
      // v34.0: rms8_loy — نقاط ولاء العملاء، مشترك بين الفروع (يكتبه أي عضو نشط غير «عرض فقط» كي تُكسب النقاط وتُستبدل في كل فرع)
      return baseId(id) in ['rms8_org', 'rms8_dir', 'rms8_core', 'rms8_pulse', 'rms8_ops', 'rms8_files', 'rms8_hist', 'rms8_loy']
        || isBranchDoc(id);
    }
    // المستندات القديمة (تشغيل ما قبل v9، أرشيف الملفات القديم، الإغلاقات المؤرشفة) تضم بيانات كل الفروع
    function isLegacyDoc(id) { return baseId(id) in ['rms8_ops', 'rms8_files', 'rms8_hist']; }
    // v34.6: الجزء إما قديم «__<رقم>» أو بنسخة «__<نسخة>_<رقم>» (الكتابة على مرحلتين للمستندات الكبيرة)
    function isChunkDoc(id)  { return id.matches('^.+__([a-z0-9]{4,20}_)?[0-9]{1,3}$'); }
    // شكل ما تكتبه طبقة التخزين فقط: رأس {parts, updatedAt, value} بسقف 500 جزء، أو جزء {chunk}
    function validShape(id) {
      return isChunkDoc(id)
        ? request.resource.data.keys().hasOnly(['chunk']) && request.resource.data.chunk is string
        : request.resource.data.keys().hasOnly(['parts', 'updatedAt', 'value', 'ver', 'cv'])
          && (!('ver' in request.resource.data) || (request.resource.data.ver is string && request.resource.data.ver.size() <= 20))
          && (!('cv' in request.resource.data) || request.resource.data.cv is int)
          && request.resource.data.parts is int
          && request.resource.data.parts >= 1 && request.resource.data.parts <= 500
          && request.resource.data.value is string;
    }

    /* ===================== v40.0 — أساس الرقابة =====================
       الدستور: tests/security/CONSTITUTION.md — كل ثابت هنا له اختبار قبول ورفض في tests/security.rules.test.mjs.
       قوائم الأدوار أدناه منسوخة حرفيًا من ROLES في App.jsx، ويكسر اختبار الانجراف البناء إن اختلفت. */
    // [ROLES:AUDIT_READ]
    function auditReaders()   { return ['head_office', 'system_admin', 'general_management', 'finance_department']; }
    // [ROLES:CLOSING_AUDIT]
    function closingAuditors() { return ['head_office', 'system_admin', 'general_management', 'finance_department']; }
    // [ROLES:CLOSING_GM]
    function closingGms()     { return ['head_office', 'system_admin', 'general_management']; }
    // [ROLES:WASTE]
    function wasteApprovers() { return ['regional_manager', 'head_office', 'system_admin', 'cost_controller', 'general_management']; }
    // [ROLES:COUNT]
    function countApprovers() { return ['branch_manager', 'regional_manager', 'head_office', 'system_admin', 'cost_controller', 'general_management', 'finance_department', 'accountant']; }
    // [ROLES:PO]
    function poApprovers()    { return ['head_office', 'system_admin', 'general_management']; }

    // نسخ «خفيفة» للقواعد الجديدة: العضوية وقائمة المدراء والسياسة تُقرأ مرة واحدة وتُمرَّر (حد 1000 عملية تقييم)
    function memOf() {
      let p = /databases/$(database)/documents/members/$(userEmail());
      return exists(p) ? get(p).data : null;
    }
    // قائمة المدراء موجودة دائمًا بعد التمهيد — قراءة مباشرة بلا exists (حد 10 قراءات للطلب)؛ غيابها يعني رفضًا وهو الصحيح
    function admOf(m) {
      return userEmail() in get(/databases/$(database)/documents/platform/admins).data.emails && (m == null || m.get('active', false) == true);
    }
    function mfaOf(m, adm) {
      let sp = /databases/$(database)/documents/platform/security;
      let sec = exists(sp) ? get(sp).data : null;
      return sec == null || twoFactor()
        || !((sec.get('admins', false) == true && adm) || (m != null && m.get('role', '') in sec.get('roles', [])));
    }
    function okUser(m, adm) { return realUser() && ((m != null && m.get('active', false) == true) || adm) && mfaOf(m, adm); }
    function roleOf(m) { return m == null ? '' : m.get('role', ''); }
    function centralOf(m) { return m != null && m.get('active', false) == true && m.get('scope', '') == 'all'; }
    function branchOf(m, adm, bId) {
      return adm || (m != null && m.get('active', false) == true
        && (m.get('scope', '') == 'all' || m.get('branchId', '') == bId || bId in m.get('branchIds', [])));
    }
    function roleIn(list, role, adm) { return role in list || (adm && 'system_admin' in list); }

    // التحديث الإجباري: لا يكتب أي جهاز بإصدار أقدم من الحد الأدنى المعلَن في platform/release
    function releasePath() { return /databases/$(database)/documents/platform/release; }
    function relOf() { return exists(releasePath()) ? get(releasePath()).data : null; }
    function cvOkRel(d, rel) { return rel == null || (('cv' in d) && d.cv is int && d.cv >= rel.minCv); }
    function cvOk(d) { return cvOkRel(d, relOf()); }
    match /platform/release {
      allow read: if isMember() || isAdmin();
      allow create, update: if isAdmin() && mfaOk()
        && request.resource.data.keys().hasOnly(['minCv', 'cutover', 'at', 'by'])
        && request.resource.data.minCv is int && request.resource.data.minCv >= 0
        && request.resource.data.cutover is string && request.resource.data.cutover.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if false;
    }

    // ثابت 1–6: سجل التدقيق — إدخال لكل عملية، بهوية الحساب ووقت الخادم، لا يُعدَّل ولا يُحذف، ولا يقرؤه موظفو الفروع
    function auditFields(d) {
      return d.keys().hasOnly(['at', 'email', 'role', 'userName', 'branchId', 'actionType', 'targetType', 'targetId', 'title', 'details', 'cv', 'legacy', 'origAt'])
        && d.keys().hasAll(['at', 'email', 'role', 'title', 'cv'])
        && d.at == request.time
        && shortStr(d.title, 200) && shortStr(d.role, 40)
        && (!('details' in d) || shortStr(d.details, 1000))
        && (!('userName' in d) || shortStr(d.userName, 120))
        && (!('actionType' in d) || shortStr(d.actionType, 40))
        && (!('targetType' in d) || shortStr(d.targetType, 40))
        && (!('targetId' in d) || shortStr(d.targetId, 300))
        && (!('origAt' in d) || shortStr(d.origAt, 40))
        && (!('branchId' in d) || shortStr(d.branchId, 80));
    }
    function auditCreate(d) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && auditFields(d) && cvOkRel(d, relOf())
        && ((d.get('legacy', false) == false && d.email == userEmail() && d.role == roleOf(m)
             && (d.get('branchId', '') == '' || branchOf(m, adm, d.get('branchId', ''))))
          || (d.get('legacy', false) == true && adm && shortStr(d.email, 120)));
    }
    function auditRead() {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && (adm || roleOf(m) in auditReaders());
    }
    match /audit_log/{id} {
      allow create: if auditCreate(request.resource.data);
      allow read: if auditRead();
      allow update, delete: if false;
    }

    // ثابت 7–15: الاعتمادات الموقّعة — توقيع لكل تقديم/اعتماد/رفض، ببصمة أرقام السجل، لا يُعدَّل ولا يُحذف
    function sigPath(id) { return /databases/$(database)/documents/signoffs/$(id); }
    // التوقيع المرجعي (تقديم/إعادة عدّ) لنفس السجل — يعيد بياناته أو null
    // قراءة مباشرة بلا exists: مرجع لمستند غير موجود = خطأ = رفض (وهو الصحيح)
    function refOf(d, field, stages) {
      let r = (field in d && d[field] is string) ? get(sigPath(d[field])).data : null;
      return (r != null && r.kind == d.kind && r.entityId == d.entityId && r.stage in stages) ? r : null;
    }
    // سجل سابق لبدء التوقيع (قبل cutover): بلا توقيع تقديم، ويُكشف لاحقًا في فحوص السلامة
    function preCutover(d, rel) { return d.get('nosub', false) == true && rel != null && d.get('edate', '9999-99-99') < rel.cutover; }
    function sigShape(d, role, rel) {
      return d.keys().hasOnly(['kind', 'stage', 'entityId', 'branchId', 'digest', 'email', 'role', 'at', 'cv', 'subRef', 'recountRef', 'nosub', 'edate', 'alert'])
        && d.keys().hasAll(['kind', 'stage', 'entityId', 'branchId', 'digest', 'email', 'role', 'at', 'cv'])
        && d.kind in ['closing', 'waste', 'count', 'po']
        && d.stage in ['submit', 'recount', 'audit', 'gm', 'approve', 'reject']
        && shortStr(d.entityId, 120) && d.entityId.size() > 0
        && d.branchId is string && d.branchId.size() <= 80
        && d.digest is string && d.digest.matches('^[0-9a-f]{64}$')
        && d.email == userEmail() && d.role == role
        && d.at == request.time && cvOkRel(d, rel)
        && (!('edate' in d) || (d.edate is string && d.edate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('alert' in d) || d.alert is bool);
    }
    // «شخص آخر غير المقدّم» (adminExempt: حيث تستثني المنصة المدير اليوم)
    function other(r, adm, adminExempt) { return r.email != userEmail() || (adminExempt && adm); }
    function approveOk(d, role, adm, rel) {
      let sub = refOf(d, 'subRef', ['submit']);
      let rc = ('recountRef' in d) ? refOf(d, 'recountRef', ['recount']) : null;
      return d.kind == 'closing'
        ? (d.stage == 'audit' ? roleIn(closingAuditors(), role, adm) && ((sub != null && other(sub, adm, false)) || preCutover(d, rel))
          : d.stage == 'gm' ? roleIn(closingGms(), role, adm)
          : d.stage == 'reject' && (roleIn(closingAuditors(), role, adm) || roleIn(closingGms(), role, adm)))
        : d.kind == 'waste'
        ? d.stage in ['approve', 'reject'] && roleIn(wasteApprovers(), role, adm) && ((sub != null && other(sub, adm, true)) || preCutover(d, rel))
        : d.kind == 'count'
        ? d.stage in ['approve', 'reject'] && roleIn(countApprovers(), role, adm)
          && ((sub != null && other(sub, adm, false) && (!('recountRef' in d) || (rc != null && other(rc, adm, false)))) || preCutover(d, rel))
        : d.stage in ['approve', 'reject'] && roleIn(poApprovers(), role, adm)
          && ((sub != null && (sub.get('alert', false) == false || other(sub, adm, true))) || preCutover(d, rel));
    }
    function sigCreate(d) {
      let m = memOf();
      let adm = admOf(m);
      let rel = relOf();
      let bId = d.get('branchId', '');
      let scope = bId == '' ? (centralOf(m) || adm) : branchOf(m, adm, bId);
      let ro = m != null && m.get('role', '') in ['accountant_view'];
      return okUser(m, adm) && scope && sigShape(d, roleOf(m), rel)
        && (d.stage in ['submit', 'recount'] ? (adm || !ro) : approveOk(d, roleOf(m), adm, rel));
    }
    function sigRead(bId) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && (adm || centralOf(m) || branchOf(m, adm, bId));
    }
    match /signoffs/{id} {
      allow create: if sigCreate(request.resource.data);
      allow read: if sigRead(resource.data.branchId);
      allow update, delete: if false;
    }

    match /platform/{docId} {
      allow read: if isMember()
        && mfaOk()
        && knownDoc(docId)
        && (!isOrgDoc(docId)    || isCentral() || isAdmin())
        && (!isCoreDoc(docId)   || isCentral() || isAdmin())
        && (!isLegacyDoc(docId) || isCentral() || isAdmin())
        && (!isBranchDoc(docId) || canBranch(branchIdOf(docId)));

      allow write: if isMember()
        && mfaOk()
        && docId != 'admins'
        && knownDoc(docId)
        && validShape(docId)
        && (isChunkDoc(docId) || cvOk(request.resource.data))
        && (!isOrgDoc(docId)    || isAdmin())
        && (!isCoreDoc(docId)   || isCentral() || isAdmin())
        && (!isLegacyDoc(docId) || isCentral() || isAdmin())
        && (!isBranchDoc(docId) || canBranch(branchIdOf(docId)))
        && (baseId(docId) != 'rms8_dir' || isAdmin())
        // مستند النبض (الحضور وسجل التدقيق) يكتبه كل عضو نشط؛ غيره ممنوع على أدوار العرض فقط
        && (baseId(docId) == 'rms8_pulse' || isAdmin() || !readOnlyRole());
    }
    /* ===== v28.0 — وحدة تقييم العملاء بالـ QR ===== */
    function validRating(v) { return v is int && v >= 1 && v <= 5; }
    function shortOrNull(v) { return v == null || (v is string && v.size() <= 20); }
    function qrBranchOpen(bId) {
      return bId is string && bId.matches('^[A-Za-z0-9_-]{1,80}$')
        && exists(/databases/$(database)/documents/qr_branches/$(bId))
        && get(/databases/$(database)/documents/qr_branches/$(bId)).data.active == true;
    }

    match /qr_branches/{branchId} {
      allow read: if true;
      allow create, update: if isMember() && (isAdmin() || (isCentral() && !readOnlyRole()))
        && request.resource.data.keys().hasOnly(['name', 'company', 'active', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    match /qr_feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['branchId', 'ratings', 'comment', 'tableNo', 'invoiceNo', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['branchId', 'ratings', 'comment', 'tableNo', 'invoiceNo', 'source', 'createdAt'])
        && qrBranchOpen(request.resource.data.branchId)
        && request.resource.data.ratings is map
        && request.resource.data.ratings.keys().hasOnly(['quality', 'taste', 'temp', 'size', 'staff', 'speed', 'pro', 'clean', 'vibe', 'comfort'])
        && request.resource.data.ratings.keys().hasAll(['quality', 'taste', 'temp', 'size', 'staff', 'speed', 'pro', 'clean', 'vibe', 'comfort'])
        && validRating(request.resource.data.ratings.quality)
        && validRating(request.resource.data.ratings.taste)
        && validRating(request.resource.data.ratings.temp)
        && validRating(request.resource.data.ratings.size)
        && validRating(request.resource.data.ratings.staff)
        && validRating(request.resource.data.ratings.speed)
        && validRating(request.resource.data.ratings.pro)
        && validRating(request.resource.data.ratings.clean)
        && validRating(request.resource.data.ratings.vibe)
        && validRating(request.resource.data.ratings.comfort)
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && shortOrNull(request.resource.data.tableNo)
        && shortOrNull(request.resource.data.invoiceNo)
        && request.resource.data.source == 'qr'
        && request.resource.data.createdAt == request.time;
      allow read: if isMember() && canBranch(resource.data.branchId);
      allow update: if isMember() && canBranch(resource.data.branchId) && !readOnlyRole()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'resolvedAt', 'updatedAt', 'ai', 'aiError'])
        && (!('status' in request.resource.data) || request.resource.data.status in ['new', 'in_progress', 'resolved']);
      allow delete: if isAdmin();
    }
    /* ===== v38.5 — سجل أخطاء الأجهزة المركزي (صيانة النظام) =====
       يكتبه كل عضو نشط باسمه فقط وبحقول محدودة الحجم (لا بيانات تشغيل)، ويقرؤه ويحذفه المسؤول وحده. لا تعديل. */
    function shortStr(v, n) { return v is string && v.size() <= n; }
    match /client_errors/{id} {
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['at', 'msg', 'stack', 'where', 'v', 'role', 'branchId', 'device', 'email', 'sig', 'n'])
        && request.resource.data.keys().hasAll(['at', 'msg', 'v', 'email', 'sig'])
        && request.resource.data.email == userEmail()
        && request.resource.data.at == request.time
        && shortStr(request.resource.data.msg, 400)
        && shortStr(request.resource.data.v, 20)
        && shortStr(request.resource.data.sig, 64)
        && (!('stack' in request.resource.data) || shortStr(request.resource.data.stack, 1500))
        && (!('where' in request.resource.data) || shortStr(request.resource.data.where, 300))
        && (!('role' in request.resource.data) || shortStr(request.resource.data.role, 40))
        && (!('branchId' in request.resource.data) || shortStr(request.resource.data.branchId, 80))
        && (!('device' in request.resource.data) || shortStr(request.resource.data.device, 120))
        && (!('n' in request.resource.data) || (request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 1000));
      allow read, delete: if isAdmin() && mfaOk();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
