rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function realUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email != null;
    }
    function userEmail() { return request.auth.token.email.lower(); }

    function isMember() {
      return realUser()
        && exists(/databases/$(database)/documents/members/$(userEmail()))
        && get(/databases/$(database)/documents/members/$(userEmail())).data.active == true;
    }

    // v28.1: المدير الموقوف أو المحذوف (عضويته active=false) يفقد صفة المدير حتى لو بقي بريده في القائمة.
    // غياب العضوية كليًا مسموح فقط لتمهيد أول مالك قبل إنشاء عضويته.
    function isAdmin() {
      return realUser()
        && exists(/databases/$(database)/documents/platform/admins)
        && (userEmail() in get(/databases/$(database)/documents/platform/admins).data.emails)
        && (!exists(/databases/$(database)/documents/members/$(userEmail()))
            || get(/databases/$(database)/documents/members/$(userEmail())).data.active == true);
    }

    function memberData() {
      return get(/databases/$(database)/documents/members/$(userEmail())).data;
    }

    function isCentral() {
      return isMember() && ('scope' in memberData()) && memberData().scope == 'all';
    }
    function myBranchId() {
      return (isMember() && ('branchId' in memberData())) ? memberData().branchId : '';
    }
    function myBranchIds() {
      return (isMember() && ('branchIds' in memberData()) && memberData().branchIds is list)
        ? memberData().branchIds : [];
    }
    // v29.5: الأدوار للعرض فقط (accountant_view) تقرأ كل البيانات لكنها لا تكتب — كان المنع في الواجهة وحدها
    function readOnlyRole() {
      return isMember() && ('role' in memberData()) && memberData().role in ['accountant_view'];
    }
    function canBranch(bId) {
      return isAdmin() || isCentral() || myBranchId() == bId || (bId in myBranchIds());
    }

    // v31.3 — التحقق بخطوتين: سياسة platform/security {roles, admins} تُلزم أدوارًا محددة (والمدراء) بأن تكون الجلسة
    // قد اجتازت الخطوة الثانية (مطالبة sign_in_second_factor في رمز Firebase) — وإلا لا قراءة ولا كتابة لبيانات المنصة.
    function twoFactor() {
      return request.auth != null && ('firebase' in request.auth.token)
        && ('sign_in_second_factor' in request.auth.token.firebase);
    }
    function secPolicy() { return get(/databases/$(database)/documents/platform/security).data; }
    function myRoleIn(roles) {
      return exists(/databases/$(database)/documents/members/$(userEmail()))
        && ('role' in memberData()) && memberData().role in roles;
    }
    function mfaRequired() {
      return exists(/databases/$(database)/documents/platform/security)
        && ((secPolicy().get('admins', false) == true && isAdmin()) || myRoleIn(secPolicy().get('roles', [])));
    }
    function mfaOk() { return twoFactor() || !mfaRequired(); }
    // v56.63 (م-1، قرار المجلس الخيار أ): سياسة قائمة «غير فارغة» (تُلزم المدراء أو أي دور) ⇒ إدارة الوصول نفسها
    //   (قائمة المدراء والعضويات والسياسة) لا تُكتب إلا بجلسة بخطوتين — حتى لو كان المدير نفسه غير مشمول بالسياسة.
    //   بلا سياسة أو بسياسة فارغة {admins:false, roles:[]} ⇒ كما كان تمامًا.
    function secArmed() {
      return exists(/databases/$(database)/documents/platform/security)
        && (secPolicy().get('admins', false) == true || secPolicy().get('roles', []).size() > 0);
    }
    function accessMfaOk() { return twoFactor() || !secArmed(); }

    function baseId(id) { return id.split('__')[0]; }

    function isOrgDoc(id)    { return baseId(id).matches('^rms8_org.*$'); }
    function isCoreDoc(id)   { return baseId(id) in ['rms8_core', 'rms8_lyc']; }   // v56.37: rms8_lyc بصلاحية المركزي
    function isBrDoc(id)     { return baseId(id).matches('^rms8_br_.+$'); }
    function isBfDoc(id)     { return baseId(id).matches('^rms8_bf_.+$'); }
    // v52.7 (G3 الخيار A): فواتير نقطة البيع لكل فرع وشهر — صلاحيتها صلاحية الفرع نفسه
    function isPosDoc(id)    { return baseId(id).matches('^rms8_pos_[A-Za-z0-9_-]{1,80}_[0-9]{6}$'); }
    // v56.37: أسماء عملاء الولاء لكل فرع (فُصلت عن rms8_loy المشترك) — صلاحيتها صلاحية الفرع؛ وأسماء حركات المركز rms8_lyc للمركز وحده
    function isLybDoc(id)    { return baseId(id).matches('^rms8_lyb_[A-Za-z0-9_-]{1,80}$'); }
    function isBranchDoc(id) { return isBrDoc(id) || isBfDoc(id) || isPosDoc(id) || isLybDoc(id); }
    // v41.7: أرشيف فواتير نقطة البيع القديمة لكل فرع وسنة — يقرؤه المركز ويكتبه مسؤول النظام وحده
    function isArchDoc(id)   { return baseId(id).matches('^rms8_arch_[A-Za-z0-9_-]{1,80}_[0-9]{4}$'); }

    function branchIdOf(id) {
      return isBrDoc(id) ? baseId(id).split('rms8_br_')[1]
        : isPosDoc(id) ? baseId(id).replace('^rms8_pos_', '').replace('_[0-9]{6}$', '')
        : isLybDoc(id) ? baseId(id).split('rms8_lyb_')[1]
        : baseId(id).split('rms8_bf_')[1];
    }

    // v40.0: أُزيلت pulseAuditSafe — كانت تفحص حقل «audit» في مستند محفوظ نصًا مضغوطًا فلا تراه أبدًا (تمر دائمًا).
    //        السجل انتقل إلى audit_log المحصّن أدناه، ومستند النبض للحضور فقط.

    match /platform/admins {
      // قائمة بريد المدراء لا تُكشف لأي حساب مسجّل: تُقرأ للأعضاء/المدراء فقط،
      // وغيابها (resource == null) يُقرأ لأي موثّق كي يعمل تمهيد أول مالك.
      allow read: if realUser() && (resource == null || isMember() || isAdmin());
      allow create: if realUser() && request.resource.data.emails == [userEmail()];
      // v56.63 (م-1): تعديل قائمة المدراء أو حذفها بجلسة بخطوتين متى وُجدت سياسة غير فارغة — كلمة سر مسروقة وحدها لا تضيف مديرًا
      allow update, delete: if isAdmin() && accessMfaOk();
    }

    // السياسة يقرؤها كل عضو (لتعرض الواجهة ما يلزمه)، ويكتبها المدير فقط — ولا يُفعّلها على نفسه دون جلسة بخطوتين (منع قفل نفسه)
    match /platform/security {
      allow read: if isMember() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['roles', 'admins', 'at'])
        && request.resource.data.roles is list && request.resource.data.admins is bool
        && (twoFactor() || !(request.resource.data.admins == true || myRoleIn(request.resource.data.roles)))
        // v56.62 (م-1): سياسة قائمة تُلزم المدراء أو أي دور ⇒ لا تُعدَّل ولا تُضعَف ولا تُطفأ إلا بجلسة بخطوتين.
        //   بلا سياسة (أول تفعيل) أو بسياسة فارغة {admins:false, roles:[]} ⇒ كما كان تمامًا
        && (twoFactor() || resource == null || !(resource.data.get('admins', false) == true || resource.data.get('roles', []).size() > 0));
      allow delete: if isAdmin() && twoFactor();
    }

    match /members/{memberEmail} {
      allow read: if isAdmin() || (realUser() && userEmail() == memberEmail);
      // v56.63 (م-1): العضويات (الدور والفرع والنطاق والتفعيل) يكتبها المدير بجلسة بخطوتين متى وُجدت سياسة غير فارغة
      allow write: if isAdmin() && accessMfaOk();
    }

    // v45.9: رموز إشعارات الأجهزة (ملخصات الإغلاق والمنصة مغلقة) — كل عضو يدير رموز بريده فقط.
    // لا دور ولا فرع في المستند: المُرسِل (حساب الخدمة) يحددهما من بيانات المنشأة، فلا يرفع الجهاز صلاحيته بنفسه.
    match /pushTokens/{id} {
      allow read: if isAdmin() || (realUser() && resource.data.email == userEmail());
      allow create, update: if realUser() && (isMember() || isAdmin()) && mfaOk() && id.size() == 40
        && request.resource.data.keys().hasOnly(['email', 'token', 'ua', 'at'])
        && request.resource.data.email == userEmail()
        && request.resource.data.token is string && request.resource.data.token.size() > 20 && request.resource.data.token.size() < 600
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 160
        && request.resource.data.at is int
        && (resource == null || resource.data.email == userEmail());
      allow delete: if isAdmin() || (realUser() && resource.data.email == userEmail());
    }

    // v28.1: قائمة سماح صريحة لأسماء المستندات — أي اسم آخر مرفوض قراءةً وكتابةً
    function knownDoc(id) {
      // v34.0: rms8_loy — نقاط ولاء العملاء، مشترك بين الفروع (يكتبه أي عضو نشط غير «عرض فقط» كي تُكسب النقاط وتُستبدل في كل فرع)
      return baseId(id) in ['rms8_org', 'rms8_dir', 'rms8_core', 'rms8_pulse', 'rms8_ops', 'rms8_files', 'rms8_hist', 'rms8_loy', 'rms8_lyc']
        || isBranchDoc(id) || isArchDoc(id);
    }
    // المستندات القديمة (تشغيل ما قبل v9، أرشيف الملفات القديم، الإغلاقات المؤرشفة) تضم بيانات كل الفروع
    function isLegacyDoc(id) { return baseId(id) in ['rms8_ops', 'rms8_files', 'rms8_hist']; }
    // v34.6: الجزء إما قديم «__<رقم>» أو بنسخة «__<نسخة>_<رقم>» (الكتابة على مرحلتين للمستندات الكبيرة)
    function isChunkDoc(id)  { return id.matches('^.+__([a-z0-9]{4,20}_)?[0-9]{1,3}$'); }
    // شكل ما تكتبه طبقة التخزين فقط: رأس {parts, updatedAt, value} بسقف 500 جزء، أو جزء {chunk}
    function validShape(id) {
      return isChunkDoc(id)
        ? request.resource.data.keys().hasOnly(['chunk']) && request.resource.data.chunk is string
        : request.resource.data.keys().hasOnly(['parts', 'updatedAt', 'value', 'ver', 'cv'])
          && (!('ver' in request.resource.data) || (request.resource.data.ver is string && request.resource.data.ver.size() <= 20))
          && (!('cv' in request.resource.data) || request.resource.data.cv is int)
          && request.resource.data.parts is int
          && request.resource.data.parts >= 1 && request.resource.data.parts <= 500
          && request.resource.data.value is string;
    }

    /* ===================== v40.0 — أساس الرقابة =====================
       الدستور: tests/security/CONSTITUTION.md — كل ثابت هنا له اختبار قبول ورفض في tests/security.rules.test.mjs.
       قوائم الأدوار أدناه منسوخة حرفيًا من ROLES في App.jsx، ويكسر اختبار الانجراف البناء إن اختلفت. */
    // [ROLES:AUDIT_READ]
    function auditReaders()   { return ['head_office', 'system_admin', 'general_management', 'finance_department']; }
    // [ROLES:CLOSING_AUDIT]
    function closingAuditors() { return ['head_office', 'system_admin', 'general_management', 'finance_department']; }
    // [ROLES:CLOSING_GM]
    function closingGms()     { return ['head_office', 'system_admin', 'general_management']; }
    // [ROLES:WASTE]
    function wasteApprovers() { return ['regional_manager', 'head_office', 'system_admin', 'cost_controller', 'general_management']; }
    // [ROLES:COUNT]
    function countApprovers() { return ['branch_manager', 'regional_manager', 'head_office', 'system_admin', 'cost_controller', 'general_management', 'finance_department', 'accountant']; }
    // [ROLES:PO]
    function poApprovers()    { return ['head_office', 'system_admin', 'general_management']; }
    // [ROLES:IBAN] — v40.9: معتمدو تغيير حسابات الدفع (آيبان الموظف والمورد)
    function ibanApprovers()  { return ['head_office', 'system_admin', 'general_management', 'finance_department']; }
    // [ROLES:GRN] — v43.5: فاحصو الاستلام (الأدوار المركزية المخوّلة بالترحيل)
    function grnInspectors()  { return ['accountant', 'cost_controller', 'finance_department', 'general_management', 'head_office', 'system_admin']; }
    // [ROLES:PINV] — v44.0: محوّلو الاستلام غير المطابق إلى فاتورة مورد (قرار المالك: المحاسب ومدير النظام فقط)
    function invBillers()     { return ['accountant', 'system_admin']; }
    // [ROLES:BRPUR] — v44.3: طلب الشراء من الفرع واستلام الفرع لأوامر الشراء (قرار المالك: مدير الفرع وحده)
    function brPurchasers()   { return ['branch_manager']; }

    // نسخ «خفيفة» للقواعد الجديدة: العضوية وقائمة المدراء والسياسة تُقرأ مرة واحدة وتُمرَّر (حد 1000 عملية تقييم)
    function memOf() {
      let p = /databases/$(database)/documents/members/$(userEmail());
      return exists(p) ? get(p).data : null;
    }
    // قائمة المدراء موجودة دائمًا بعد التمهيد — قراءة مباشرة بلا exists (حد 10 قراءات للطلب)؛ غيابها يعني رفضًا وهو الصحيح
    function admOf(m) {
      return userEmail() in get(/databases/$(database)/documents/platform/admins).data.emails && (m == null || m.get('active', false) == true);
    }
    function mfaOf(m, adm) {
      let sp = /databases/$(database)/documents/platform/security;
      let sec = exists(sp) ? get(sp).data : null;
      return sec == null || twoFactor()
        || !((sec.get('admins', false) == true && adm) || (m != null && m.get('role', '') in sec.get('roles', [])));
    }
    function okUser(m, adm) { return realUser() && ((m != null && m.get('active', false) == true) || adm) && mfaOf(m, adm); }
    function roleOf(m) { return m == null ? '' : m.get('role', ''); }
    function centralOf(m) { return m != null && m.get('active', false) == true && m.get('scope', '') == 'all'; }
    function branchOf(m, adm, bId) {
      return adm || (m != null && m.get('active', false) == true
        && (m.get('scope', '') == 'all' || m.get('branchId', '') == bId || bId in m.get('branchIds', [])));
    }
    function roleIn(list, role, adm) { return role in list || (adm && 'system_admin' in list); }

    // التحديث الإجباري: لا يكتب أي جهاز بإصدار أقدم من الحد الأدنى المعلَن في platform/release
    function releasePath() { return /databases/$(database)/documents/platform/release; }
    function relOf() { return exists(releasePath()) ? get(releasePath()).data : null; }
    function cvOkRel(d, rel) { return rel == null || (('cv' in d) && d.cv is int && d.cv >= rel.minCv); }
    function cvOk(d) { return cvOkRel(d, relOf()); }
    match /platform/release {
      allow read: if isMember() || isAdmin();
      allow create, update: if isAdmin() && mfaOk()
        && request.resource.data.keys().hasOnly(['minCv', 'cutover', 'at', 'by'])
        && request.resource.data.minCv is int && request.resource.data.minCv >= 0
        && request.resource.data.cutover is string && request.resource.data.cutover.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if false;
    }

    // ثابت 1–6: سجل التدقيق — إدخال لكل عملية، بهوية الحساب ووقت الخادم، لا يُعدَّل ولا يُحذف، ولا يقرؤه موظفو الفروع
    function auditFields(d) {
      return d.keys().hasOnly(['at', 'email', 'role', 'userName', 'branchId', 'actionType', 'targetType', 'targetId', 'title', 'details', 'cv', 'legacy', 'origAt'])
        && d.keys().hasAll(['at', 'email', 'role', 'title', 'cv'])
        && d.at == request.time
        && shortStr(d.title, 200) && shortStr(d.role, 40)
        && (!('details' in d) || shortStr(d.details, 1000))
        && (!('userName' in d) || shortStr(d.userName, 120))
        && (!('actionType' in d) || shortStr(d.actionType, 40))
        && (!('targetType' in d) || shortStr(d.targetType, 40))
        && (!('targetId' in d) || shortStr(d.targetId, 300))
        && (!('origAt' in d) || shortStr(d.origAt, 40))
        && (!('branchId' in d) || shortStr(d.branchId, 80));
    }
    function auditCreate(d) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && auditFields(d) && cvOkRel(d, relOf())
        && ((d.get('legacy', false) == false && d.email == userEmail() && d.role == roleOf(m)
             && (d.get('branchId', '') == '' || branchOf(m, adm, d.get('branchId', ''))))
          || (d.get('legacy', false) == true && adm && shortStr(d.email, 120)));
    }
    function auditRead() {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && (adm || roleOf(m) in auditReaders());
    }
    match /audit_log/{id} {
      allow create: if auditCreate(request.resource.data);
      allow read: if auditRead();
      allow update, delete: if false;
    }

    // ثابت 7–15: الاعتمادات الموقّعة — توقيع لكل تقديم/اعتماد/رفض، ببصمة أرقام السجل، لا يُعدَّل ولا يُحذف
    function sigPath(id) { return /databases/$(database)/documents/signoffs/$(id); }
    // التوقيع المرجعي (تقديم/إعادة عدّ) لنفس السجل — يعيد بياناته أو null
    // قراءة مباشرة بلا exists: مرجع لمستند غير موجود = خطأ = رفض (وهو الصحيح)
    function refOf(d, field, stages) {
      let r = (field in d && d[field] is string) ? get(sigPath(d[field])).data : null;
      return (r != null && r.kind == d.kind && r.entityId == d.entityId && r.stage in stages) ? r : null;
    }
    // سجل سابق لبدء التوقيع (قبل cutover): بلا توقيع تقديم، ويُكشف لاحقًا في فحوص السلامة
    function preCutover(d, rel) { return d.get('nosub', false) == true && rel != null && d.get('edate', '9999-99-99') < rel.cutover; }
    function sigShape(d, role, rel) {
      return d.keys().hasOnly(['kind', 'stage', 'entityId', 'branchId', 'digest', 'email', 'role', 'at', 'cv', 'subRef', 'recountRef', 'nosub', 'edate', 'alert'])
        && d.keys().hasAll(['kind', 'stage', 'entityId', 'branchId', 'digest', 'email', 'role', 'at', 'cv'])
        && d.kind in ['closing', 'waste', 'count', 'po', 'iban', 'grn', 'pinv', 'preq', 'prcv']
        && d.stage in ['submit', 'recount', 'audit', 'gm', 'approve', 'reject']
        && shortStr(d.entityId, 120) && d.entityId.size() > 0
        && d.branchId is string && d.branchId.size() <= 80
        && d.digest is string && d.digest.matches('^[0-9a-f]{64}$')
        && d.email == userEmail() && d.role == role
        && d.at == request.time && cvOkRel(d, rel)
        && (!('edate' in d) || (d.edate is string && d.edate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('alert' in d) || d.alert is bool);
    }
    // «شخص آخر غير المقدّم» (adminExempt: حيث تستثني المنصة المدير اليوم)
    function other(r, adm, adminExempt) { return r.email != userEmail() || (adminExempt && adm); }
    function approveOk(d, role, adm, rel) {
      let sub = refOf(d, 'subRef', ['submit']);
      let rc = ('recountRef' in d) ? refOf(d, 'recountRef', ['recount']) : null;
      return d.kind == 'closing'
        ? (d.stage == 'audit' ? roleIn(closingAuditors(), role, adm) && ((sub != null && other(sub, adm, false)) || preCutover(d, rel))
          : d.stage == 'gm' ? roleIn(closingGms(), role, adm)
          : d.stage == 'reject' && (roleIn(closingAuditors(), role, adm) || roleIn(closingGms(), role, adm)))
        : d.kind == 'waste'
        ? d.stage in ['approve', 'reject'] && roleIn(wasteApprovers(), role, adm) && ((sub != null && other(sub, adm, true)) || preCutover(d, rel))
        : d.kind == 'count'
        ? d.stage in ['approve', 'reject'] && roleIn(countApprovers(), role, adm)
          && ((sub != null && other(sub, adm, false) && (!('recountRef' in d) || (rc != null && other(rc, adm, false)))) || preCutover(d, rel))
        : d.kind == 'iban'
        // ثابت 21: تغيير حساب الدفع يعتمده شخص آخر غير طالبه (بلا استثناء للمدير) وبالآيبان نفسه المقدَّم (البصمة ذاتها)، ولا مسار «قبل البدء»
        ? d.stage in ['approve', 'reject'] && roleIn(ibanApprovers(), role, adm) && sub != null && other(sub, adm, false) && d.digest == sub.digest && d.branchId == ''
        : d.kind == 'grn'
        // ث31 (v43.5): فحص الاستلام يجريه فاحص مؤهل غير من سجّل الاستلام (يُستثنى المدير كما في أوامر الشراء)، ولا مسار «قبل البدء»
        ? d.stage == 'approve' && roleIn(grnInspectors(), role, adm) && sub != null && other(sub, adm, true) && d.branchId == ''
        : d.kind == 'pinv'
        // ث32 (v43.5): فاتورة مورد بفرق سعر يتجاوز التسامح يعتمدها/يرفضها معتمد أوامر الشراء غير مسجّلها
        ? d.stage in ['approve', 'reject'] && roleIn(poApprovers(), role, adm) && sub != null && sub.get('alert', false) == true && other(sub, adm, true) && d.branchId == ''
        : d.stage in ['approve', 'reject'] && roleIn(poApprovers(), role, adm)
          && ((sub != null && (sub.get('alert', false) == false || other(sub, adm, true))) || preCutover(d, rel));
    }
    function sigCreate(d) {
      let m = memOf();
      let adm = admOf(m);
      let rel = relOf();
      let bId = d.get('branchId', '');
      let scope = bId == '' ? (centralOf(m) || adm) : branchOf(m, adm, bId);
      let ro = m != null && m.get('role', '') in ['accountant_view'];
      return okUser(m, adm) && scope && sigShape(d, roleOf(m), rel)
        // ث34 (v44.3): طلب شراء الفرع واستلامه لأمر شراء — يوقّعه مدير ذلك الفرع وحده (تقديمًا فقط)، والمركز لا يحوّل/يرحّل بلا توقيع موثّق
        && (d.kind in ['preq', 'prcv'] ? d.stage == 'submit' && bId != '' && roleIn(brPurchasers(), roleOf(m), adm)
          : d.kind == 'pinv' && d.stage == 'submit' ? roleIn(invBillers(), roleOf(m), adm)   // ث33 (v44.0)
          : d.stage in ['submit', 'recount'] ? (adm || !ro) : approveOk(d, roleOf(m), adm, rel));
    }
    function sigRead(bId) {
      let m = memOf();
      let adm = admOf(m);
      // v56.59 (تدقيق H): سجل المركز (فرع '') للمدير والمركز وحدهما — عضو بلا branchId (كمدير إقليمي) لا يطابق '' فيقرأه
      return okUser(m, adm) && (adm || centralOf(m) || (bId != '' && branchOf(m, adm, bId)));
    }
    match /signoffs/{id} {
      allow create: if sigCreate(request.resource.data);
      allow read: if sigRead(resource.data.branchId);
      allow update, delete: if false;
    }

    /* ===== v41.9 — الإغلاقات سجلات مستقلة بقواعد على مستوى الحقل (ث27–ث30) =====
       الحالة والاعتماد حقول يراها الخادم: الفرع يكتب المسودة/المرحّل فقط، ولا يلمس إغلاقًا معتمدًا؛
       «معتمد/مرفوض/اعتماد نهائي» لا يُكتب إلا مربوطًا بتوقيع موثّق للكاتب نفسه على السجل نفسه وبالبصمة ذاتها
       (والتوقيع نفسه تحرسه approveOk: المدقق المؤهل وغير المقدّم). المدير وحده يعيد المعتمد مسودة أو يحذفه. */
    function clShape(d, id) {
      return d.keys().hasOnly(['branchId', 'date', 'status', 'gm', 'digest', 'data', 'sigRef', 'by', 'at', 'cv'])
        && d.keys().hasAll(['branchId', 'date', 'status', 'gm', 'digest', 'data', 'by', 'at', 'cv'])
        && d.branchId is string && d.branchId.matches('^[A-Za-z0-9_-]{1,80}$')
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.status in ['draft', 'submitted', 'approved', 'rejected']
        && d.gm in ['', 'pending', 'approved', 'rejected']
        && d.digest is string && d.digest.matches('^[0-9a-f]{64}$')
        && d.data is string && d.data.size() <= 400000
        && (!('sigRef' in d) || shortStr(d.sigRef, 200))
        && d.by == userEmail() && d.at == request.time && cvOk(d)
        && id.matches('^[A-Za-z0-9_-]{1,120}$');
    }
    // توقيع موثّق للكاتب نفسه على هذا الإغلاق، بالمرحلة المطلوبة والبصمة نفسها
    function clSigned(d, id, stage) {
      let r = ('sigRef' in d) ? get(sigPath(d.sigRef)).data : null;
      return r != null && r.kind == 'closing' && r.entityId == id && r.stage == stage
        && r.email == userEmail() && r.digest == d.digest && r.branchId == d.branchId;
    }
    // كتابة تشغيلية (بلا قرار): مسودة أو ترحيل، ولا اعتماد نهائي
    function clWorking(d) { return d.status in ['draft', 'submitted'] && d.gm in ['', 'pending']; }
    /* v56.0 (GAP-003) — إقفال الفترات على الخادم للإغلاقات (fin_periods/locks.lockedTo): في الفترة المقفلة لا شيء يغيّر الدفتر —
       لا إغلاق جديد، ولا تغيير أرقامه (البصمة) أو تاريخه أو فرعه، ولا انتقال بين «محتسب» (مرحّل/معتمد) و«غير محتسب».
       يمر ما لا يمس القيود (حالة التوريد، تنظيف الصور، الاعتماد النهائي لمرحّل) — كما يفعل حارس التطبيق lockedLedgerChanged. يسري على المدير أيضًا. */
    function clCounted(s) { return s in ['submitted', 'approved']; }
    function clLockOk(d, old) {
      let lt = finLockedTo();
      return (d.date > lt && (old == null || old.date > lt))
        || (old != null && d.date == old.date && d.branchId == old.branchId && d.digest == old.digest && clCounted(d.status) == clCounted(old.status));
    }
    function clDelLockOk(o) { return !clCounted(o.status) || o.date > finLockedTo(); }
    /* v56.0 (GAP-002) — إغلاق واحد غير مرفوض لكل فرع ويوم على الخادم: مفتاح closing_keys/{فرع~تاريخ} يُكتب في الدفعة الذرية نفسها.
       يصبح إلزاميًا متى رفع المدير الحد الأدنى للإصدار إلى v56.0 (minCv ≥ 560000) — قبلها لا تملك الأجهزة القديمة بروتوكول المفتاح. */
    function clKeyPath(b, dt) { return /databases/$(database)/documents/closing_keys/$(b + '~' + dt); }
    function clKeysOn(rel) { return rel != null && rel.minCv >= 560000; }
    // يدخل السجل خانة يوم: إنشاء، أو عودة من «مرفوض»، أو تغيير التاريخ أو الفرع
    function clEnters(d, old) { return d.status != 'rejected' && (old == null || old.status == 'rejected' || old.date != d.date || old.branchId != d.branchId); }
    function clKeyOk(id, d, old) {
      return !clEnters(d, old) || !clKeysOn(relOf())
        || (existsAfter(clKeyPath(d.branchId, d.date)) && getAfter(clKeyPath(d.branchId, d.date)).data.id == id);
    }
    function clWrite(id, d, old) {
      let m = memOf();
      let adm = admOf(m);
      let ro = m != null && m.get('role', '') in ['accountant_view'];
      let base = okUser(m, adm) && clShape(d, id) && branchOf(m, adm, d.branchId) && (adm || !ro);
      let mine = old == null || old.branchId == d.branchId;
      return base && mine && clLockOk(d, old) && clKeyOk(id, d, old) && (adm
        // تشغيل: لا يلمس سجلًا معتمدًا، ولا يكتب حالة قرار
        || (clWorking(d) && (old == null || old.status in ['draft', 'submitted', 'rejected']))
        // تدقيق: مرحّل ← معتمد (بانتظار النهائي)
        || (old != null && old.status == 'submitted' && d.status == 'approved' && d.gm in ['', 'pending'] && clSigned(d, id, 'audit'))
        // اعتماد نهائي: معتمد ← معتمد نهائيًا (البصمة لا تتغير)
        || (old != null && old.status == 'approved' && d.status == 'approved' && d.gm == 'approved' && d.digest == old.digest && clSigned(d, id, 'gm'))
        // رفض: مرحّل أو معتمد ← مرفوض
        || (old != null && old.status in ['submitted', 'approved'] && d.status == 'rejected' && clSigned(d, id, 'reject'))
        // المركز (الخزينة): بيانات تشغيلية كحالة التوريد — دون تغيير الحالة ولا القرار ولا بصمة الأرقام
        || (old != null && centralOf(m) && d.status == old.status && d.gm == old.gm && d.digest == old.digest));
    }
    match /closings/{id} {
      allow read: if sigRead(resource.data.branchId);
      allow create: if clWrite(id, request.resource.data, null);
      allow update: if clWrite(id, request.resource.data, resource.data);
      // الحذف: المدير، أو الفرع لمسودته فقط — v56.0: ولا يُحذف إغلاق محتسب في فترة مقفلة (حتى من المدير)
      allow delete: if clDelLockOk(resource.data) && ((isAdmin() && mfaOk())
        || (resource.data.status == 'draft' && sigRead(resource.data.branchId) && !readOnlyRole()));
    }
    /* v56.0 (GAP-002) — فهرس التفرد: مفتاح لكل فرع ويوم يشير إلى الإغلاق الشاغل. يُكتب مع الإغلاق نفسه في دفعة واحدة،
       ولا يُنقل لإغلاق آخر إلا إن صار الشاغل مرفوضًا أو محذوفًا أو انتقل لخانة أخرى (بعد الدفعة). */
    function clSlotFree(oldId, key) {
      let p = /databases/$(database)/documents/closings/$(oldId);
      return !existsAfter(p) || getAfter(p).data.status == 'rejected' || (getAfter(p).data.branchId + '~' + getAfter(p).data.date) != key;
    }
    function ckWrite(key, d, old) {
      let m = memOf();
      let adm = admOf(m);
      let ro = m != null && m.get('role', '') in ['accountant_view'];
      let p = /databases/$(database)/documents/closings/$(d.id);
      return okUser(m, adm) && (adm || !ro)
        && d.keys().hasOnly(['branchId', 'date', 'id', 'by', 'at']) && d.keys().hasAll(['branchId', 'date', 'id', 'by', 'at'])
        && d.branchId is string && d.branchId.matches('^[A-Za-z0-9_-]{1,80}$')
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.id is string && d.id.matches('^[A-Za-z0-9_-]{1,120}$')
        && key == d.branchId + '~' + d.date && d.by == userEmail() && d.at == request.time
        && branchOf(m, adm, d.branchId)
        && existsAfter(p) && getAfter(p).data.branchId == d.branchId && getAfter(p).data.date == d.date && getAfter(p).data.status != 'rejected'
        && (old == null || old.id == d.id || clSlotFree(old.id, key));
    }
    match /closing_keys/{key} {
      allow read: if sigRead(resource.data.branchId);
      allow create: if ckWrite(key, request.resource.data, null);
      allow update: if ckWrite(key, request.resource.data, resource.data);
      allow delete: if (isAdmin() && mfaOk()) || (sigRead(resource.data.branchId) && !readOnlyRole() && clSlotFree(resource.data.id, key));
    }

    /* ===== v56.4 — MUKTASAB POS الدفعة 2a: فواتير نقطة البيع سجلات مستقلة (نسخ موازٍ — docs/pos/POS_DATABASE_DESIGN.md) =====
       الفاتورة نفسها لا تُعدَّل ولا تُحذف أبدًا: الإنشاء «مدفوعة» من عضو الفرع، والمرتجع لأدوار الإدارة،
       والتعديل الوحيد المسموح إلغاء فاتورة بيع (paid → void) لأدوار الإدارة بحقلي status/voidData فقط. ولا كتابة في فترة مقفلة. */
    function posMgrRoles() { return ['branch_manager', 'regional_manager', 'head_office', 'general_management', 'system_admin']; }
    function porShape(d, id) {
      return d.keys().hasOnly(['branchId', 'date', 'kind', 'status', 'no', 'dev', 'total', 'vat', 'digest', 'data', 'voidData', 'repair', 'by', 'at', 'cv'])
        && d.keys().hasAll(['branchId', 'date', 'kind', 'status', 'no', 'dev', 'total', 'vat', 'digest', 'data', 'by', 'at', 'cv'])
        && d.branchId is string && d.branchId.matches('^[A-Za-z0-9_-]{1,80}$')
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.kind in ['sale', 'return'] && d.status in ['paid', 'void']
        && shortStr(d.no, 60) && shortStr(d.dev, 12)
        && (d.total is int || d.total is float) && (d.vat is int || d.vat is float)
        && d.digest is string && d.digest.matches('^[0-9a-f]{64}$')
        && d.data is string && d.data.size() <= 200000
        && (!('voidData' in d) || shortStr(d.voidData, 4000))
        && (!('repair' in d) || shortStr(d.repair, 2000))
        && d.by == userEmail() && d.at == request.time && cvOk(d)
        && id.matches('^[A-Za-z0-9_-]{1,120}$');
    }
    function porCreate(id, d) {
      let m = memOf();
      let adm = admOf(m);
      let ro = m != null && m.get('role', '') in ['accountant_view'];
      return okUser(m, adm) && (adm || !ro) && porShape(d, id) && branchOf(m, adm, d.branchId)
        && d.status == 'paid' && !('voidData' in d) && !('repair' in d) && d.date > finLockedTo()
        && (d.kind == 'sale' || adm || roleIn(posMgrRoles(), roleOf(m), adm));
    }
    function porVoid(id, d, old) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && porShape(d, id) && branchOf(m, adm, old.branchId)
        && (adm || roleIn(posMgrRoles(), roleOf(m), adm))
        && old.kind == 'sale' && old.status == 'paid' && d.status == 'void' && ('voidData' in d)
        && d.diff(old).affectedKeys().hasOnly(['status', 'voidData', 'by', 'at', 'cv'])
        && old.date > finLockedTo();
    }
    /* v56.6 (قرار المالك 2026-11-26) — إصلاح سجل خاطئ: لمسؤول النظام وحده، بسبب مكتوب (repair) يُسجَّل في السجل نفسه،
       لنفس الفرع والنوع والتاريخ، وخارج الفترة المقفلة. لا حذف أبدًا. */
    function porRepair(id, d, old) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && adm && porShape(d, id) && ('repair' in d) && d.repair.size() >= 10
        && d.branchId == old.branchId && d.kind == old.kind && d.date == old.date && old.date > finLockedTo()
        && (old.get('repair', '') != d.repair);
    }
    match /pos_orders/{id} {
      allow read: if sigRead(resource.data.branchId);
      allow create: if porCreate(id, request.resource.data);
      allow update: if porVoid(id, request.resource.data, resource.data) || porRepair(id, request.resource.data, resource.data);
      allow delete: if false;
    }

    /* ===== v56.56 (قرار المجلس E) — حسم تعارضات فواتير نقطة البيع بعد عودة الاتصال: سجل للإضافة فقط pos_conflict_res/{orderId} =====
       الحاسم مدير الفرع أو مسؤول النظام لفرعه، والكاتب = الحساب ووقت الخادم، ولا تعديل ولا حذف (المعرّف = الفاتورة ⇒ حسم واحد).
       فصل المهام: الحاسم ليس من أنشأ السجل المحمي للفاتورة (pos_orders.by). «إلغاء بمرتجع»: الفاتورة ملغاة في سجلها المحمي،
       أو مرتجع محمي غير ملغى من الفرع نفسه يشير إليها (refId في محتواه) — لا حذف أبدًا. */
    function pcrShape(d, id) {
      return d.keys().hasOnly(['branchId', 'orderId', 'tabId', 'act', 'doc', 'retId', 'byName', 'by', 'at', 'cv'])
        && d.keys().hasAll(['branchId', 'orderId', 'tabId', 'act', 'by', 'at', 'cv'])
        && d.branchId is string && d.branchId.matches('^[A-Za-z0-9_-]{1,80}$')
        && id.matches('^[A-Za-z0-9_-]{1,120}$') && d.orderId == id
        && shortStr(d.tabId, 120) && d.act in ['keep', 'void']
        && (!('doc' in d) || shortStr(d.doc, 200)) && (!('byName' in d) || shortStr(d.byName, 200))
        && (!('retId' in d) || (d.retId is string && d.retId.matches('^[A-Za-z0-9_-]{1,120}$')))
        && d.by == userEmail() && d.at == request.time && cvOk(d);
    }
    function pcrRetOk(d, id) {
      return ('retId' in d)
        && exists(/databases/$(database)/documents/pos_orders/$(d.retId))
        && get(/databases/$(database)/documents/pos_orders/$(d.retId)).data.kind == 'return'
        && get(/databases/$(database)/documents/pos_orders/$(d.retId)).data.status == 'paid'
        && get(/databases/$(database)/documents/pos_orders/$(d.retId)).data.branchId == d.branchId
        && get(/databases/$(database)/documents/pos_orders/$(d.retId)).data.data.matches('.*"refId":"' + id + '".*');
    }
    // m2: بريد مُصدِر الفاتورة المسجّل داخل محتوى سجلها المحمي ("byEmail":"…" — يُكتب على الفواتير الجديدة)، وإلا ''
    function porIssuer(op) {
      let parts = get(op).data.data.split('"byEmail":"');
      return parts.size() > 1 ? parts[1].split('"')[0] : '';
    }
    function pcrCreate(id, d) {
      let m = memOf();
      let adm = admOf(m);
      let op = /databases/$(database)/documents/pos_orders/$(id);
      return okUser(m, adm) && pcrShape(d, id) && branchOf(m, adm, d.branchId)
        && roleIn(['branch_manager', 'system_admin'], roleOf(m), adm)
        && exists(op) && get(op).data.branchId == d.branchId && get(op).data.kind == 'sale'
        && get(op).data.by != userEmail() && porIssuer(op) != userEmail()   // m2: لا كاتب السجل المحمي ولا مُصدِر الفاتورة (byEmail داخل محتواه)
        && (d.act == 'keep' || get(op).data.status == 'void' || pcrRetOk(d, id));
    }
    /* v56.56 (قرار المجلس m1) — قائمة التعارضات نفسها سجل محمي للإضافة فقط pos_conflicts/{orderId}: يكتبه أي عضو للفرع (غير العرض فقط) متى رُصد التعارض،
       بشرط وجود السجل المحمي للفاتورة للفرع نفسه، والكاتب = الحساب ووقت الخادم؛ لا تعديل ولا حذف — فحذف tab.conflicts من مستند الفرع لا يخفي تعارضًا. */
    function pcfCreate(id, d) {
      let m = memOf();
      let adm = admOf(m);
      let ro = m != null && m.get('role', '') in ['accountant_view'];
      let op = /databases/$(database)/documents/pos_orders/$(id);
      return okUser(m, adm) && (adm || !ro)
        && d.keys().hasOnly(['branchId', 'orderId', 'tabId', 'date', 'table', 'orderNo', 'why', 'total', 'by', 'at', 'cv'])
        && d.keys().hasAll(['branchId', 'orderId', 'tabId', 'date', 'by', 'at', 'cv'])
        && d.branchId is string && d.branchId.matches('^[A-Za-z0-9_-]{1,80}$')
        && id.matches('^[A-Za-z0-9_-]{1,120}$') && d.orderId == id && shortStr(d.tabId, 120)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('table' in d) || shortStr(d.table, 20)) && (!('orderNo' in d) || shortStr(d.orderNo, 60)) && (!('why' in d) || shortStr(d.why, 400))
        && (!('total' in d) || d.total is int || d.total is float)
        && d.by == userEmail() && d.at == request.time && cvOk(d)
        && branchOf(m, adm, d.branchId) && exists(op) && get(op).data.branchId == d.branchId;
    }
    match /pos_conflicts/{id} {
      allow read: if sigRead(resource.data.branchId);
      allow create: if pcfCreate(id, request.resource.data);
      allow update, delete: if false;
    }
    match /pos_conflict_res/{id} {
      allow read: if sigRead(resource.data.branchId);
      allow create: if pcrCreate(id, request.resource.data);
      allow update, delete: if false;
    }

    /* ===== v56.17 — MUKTASAB GROWTH الدفعة 2: سجلات الموافقة التسويقية وحركات الولاء للإضافة فقط (نسخ موازٍ — docs/growth/GROWTH_RECORDS_DESIGN.md) =====
       السجل لا يُعدَّل ولا يُحذف أبدًا: إلغاء الاشتراك أو تصحيح النقاط حركة جديدة. الكاتب = الحساب، والوقت = وقت الخادم.
       رقم الفرع فارغ ⇒ سجل مركزي (للمركز وحده كتابةً وقراءةً)؛ وإلا فلعضو ذلك الفرع والمركز. */
    function grRole(m, adm) { return adm || (m != null && !(m.get('role', '') in ['accountant_view'])); }
    function grBranch(m, adm, b) { return b == '' ? (adm || centralOf(m)) : branchOf(m, adm, b); }
    function mkcShape(d, id) {
      return d.keys().hasOnly(['phone', 'status', 'ch', 'src', 'note', 'branchId', 'byName', 'by', 'at', 'cv'])
        && d.keys().hasAll(['phone', 'status', 'ch', 'src', 'branchId', 'by', 'at', 'cv'])
        && d.phone is string && d.phone.matches('^[0-9]{6,15}$')
        && d.status in ['in', 'out'] && d.ch in ['all', 'whatsapp', 'sms', 'email', 'app']
        && shortStr(d.src, 200) && (!('note' in d) || shortStr(d.note, 500)) && (!('byName' in d) || shortStr(d.byName, 120))
        && d.branchId is string && (d.branchId == '' || d.branchId.matches('^[A-Za-z0-9_-]{1,80}$'))
        && d.by == userEmail() && d.at == request.time && cvOk(d)
        && id.matches('^[A-Za-z0-9_-]{1,120}$');
    }
    function mkcCreate(id, d) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && grRole(m, adm) && mkcShape(d, id) && grBranch(m, adm, d.branchId);
    }
    match /mkt_consents/{id} {
      allow read: if sigRead(resource.data.branchId);
      allow create: if mkcCreate(id, request.resource.data);
      allow update, delete: if false;
    }
    function lytShape(d, id) {
      return d.keys().hasOnly(['phone', 'pts', 'ord', 'br', 'name', 'byName', 'by', 'at', 'cv'])
        && d.keys().hasAll(['phone', 'pts', 'br', 'by', 'at', 'cv'])
        && d.phone is string && d.phone.matches('^[0-9]{6,15}$')
        && (d.pts is int || d.pts is float) && d.pts >= -1000000 && d.pts <= 1000000
        && (!('ord' in d) || shortStr(d.ord, 300)) && (!('name' in d) || shortStr(d.name, 120)) && (!('byName' in d) || shortStr(d.byName, 120))
        && d.br is string && (d.br == '' || d.br.matches('^[A-Za-z0-9_-]{1,80}$'))
        && d.by == userEmail() && d.at == request.time && cvOk(d)
        && id.matches('^[A-Za-z0-9_:.-]{1,160}$');
    }
    function lytCreate(id, d) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && grRole(m, adm) && lytShape(d, id) && grBranch(m, adm, d.br);
    }
    match /loy_tx/{id} {
      allow read: if sigRead(resource.data.br);
      allow create: if lytCreate(id, request.resource.data);
      allow update, delete: if false;
    }

    /* ===== v56.36 — الحماية على الخادم لسجلات دمج العملاء (تكميل ضابط التسويق M4) =====
       نسخة محمية من mktMerges: إضافة فقط (لا تعديل ولا حذف)، الكاتب = الحساب ووقت الخادم، للمركز وحده (لا دور العرض).
       فصل المهام على الخادم: الرفض أو التراجع المعتمد يشير إلى طلب قائم لنفس الدمج ولا يكتبه صاحب الطلب؛ والتراجع بلا طلب لدمج بلا نقاط فقط.
       نسخ التاريخ (seed) لمسؤول النظام وحده ويحمل الكاتب الأصلي (origBy) — يُعفى من فصل المهام لأن الطلب المنسوخ يحمل حسابه هو، ويبقى origBy صاحب الطلب.
       المصدر (rms8_core.mktMerges) ما زال يُكتب من المركز؛ بلا «الخادم مصدر الدمج» يكشف هذا السجلُ المخالفة، ومعه (v56.39) لا يُعتدّ بسجل لا يطابق الخادم. */
    function mkmDoc(x) { return /databases/$(database)/documents/mkt_merges/$(x); }
    function mkmShape(d, id) {
      return d.keys().hasOnly(['kind', 'from', 'to', 'pts', 'ref', 'reqId', 'reason', 'byName', 'origBy', 'origAt', 'seed', 'by', 'at', 'cv'])
        && d.keys().hasAll(['kind', 'ref', 'reason', 'by', 'at', 'cv'])
        && d.kind in ['merge', 'undoReq', 'undo', 'rej']
        && shortStr(d.ref, 120) && d.ref.matches('^[A-Za-z0-9_-]{1,120}$') && shortStr(d.reason, 500)
        && (!('byName' in d) || shortStr(d.byName, 120)) && (!('origBy' in d) || shortStr(d.origBy, 200)) && (!('origAt' in d) || shortStr(d.origAt, 40))
        && (!('from' in d) || (d.from is string && d.from.matches('^[0-9]{6,15}$'))) && (!('to' in d) || (d.to is string && d.to.matches('^[0-9]{6,15}$')))
        && (!('pts' in d) || ((d.pts is int || d.pts is float) && d.pts >= 0 && d.pts <= 10000000))
        && (!('reqId' in d) || (d.kind == 'undo' && d.reqId is string && d.reqId.matches('^[A-Za-z0-9_-]{1,120}$')))
        && (!('seed' in d) || d.seed == true)
        && (d.kind != 'merge' || (d.ref == id && 'from' in d && 'to' in d))
        && d.by == userEmail() && d.at == request.time && cvOk(d)
        && id.matches('^[A-Za-z0-9_-]{1,120}$')
        // v56.39 (مراجعة الأمن): معرّف ثابت للقرار — التراجع <الدمج>-u والرفض <الطلب>-r؛ ولا يحجز غيرهما هذه اللاحقة (منع تعطيل التراجع)، فقرار واحد لكل دمج/طلب.
        //   نسخ التاريخ (seed) يحمل معرّفاته الأصلية العشوائية للتراجع والرفض.
        && (d.kind in ['undo', 'rej'] ? (('seed' in d) || id == d.ref + (d.kind == 'undo' ? '-u' : '-r')) : !id.matches('^.*-[ur]$'));
    }
    function mkmIs(x, k) { return exists(mkmDoc(x)) && get(mkmDoc(x)).data.kind == k; }
    // صاحب الطلب = كاتبه، أو كاتبه الأصلي إن كان منسوخًا من التاريخ (origBy) — فلا يعتمده صاحبه بعد نسخه باسم المسؤول
    function mkmReqBy(x) { return get(mkmDoc(x)).data.get('origBy', get(mkmDoc(x)).data.by); }
    function mkmOtherReq(x, mg, seed) { return mkmIs(x, 'undoReq') && get(mkmDoc(x)).data.ref == mg && (seed || (get(mkmDoc(x)).data.by != userEmail() && mkmReqBy(x) != userEmail())); }
    function mkmLinkOk(d, seed) {
      return d.kind == 'merge'
        || (d.kind == 'undoReq' && mkmIs(d.ref, 'merge'))
        || (d.kind == 'rej' && mkmIs(d.ref, 'undoReq') && (seed || (get(mkmDoc(d.ref)).data.by != userEmail() && mkmReqBy(d.ref) != userEmail())))
        || (d.kind == 'undo' && mkmIs(d.ref, 'merge')
            && (('reqId' in d) ? mkmOtherReq(d.reqId, d.ref, seed) : (seed || get(mkmDoc(d.ref)).data.get('pts', 0) <= 0)));
    }
    function mkmCreate(id, d) {
      let m = memOf();
      let adm = admOf(m);
      let seed = ('seed' in d) && d.seed == true;
      return okUser(m, adm) && grRole(m, adm) && (adm || centralOf(m)) && (!seed || adm) && mkmShape(d, id) && mkmLinkOk(d, seed);
    }
    match /mkt_merges/{id} {
      allow read: if sigRead('');   // المركز والمسؤول، مع فحص العضوية والتحقق الثنائي
      allow create: if mkmCreate(id, request.resource.data);
      allow update, delete: if false;
    }

    match /platform/{docId} {
      allow read: if isMember()
        && mfaOk()
        && knownDoc(docId)
        && (!isOrgDoc(docId)    || isCentral() || isAdmin())
        && (!isCoreDoc(docId)   || isCentral() || isAdmin())
        && (!isLegacyDoc(docId) || isCentral() || isAdmin())
        && (!isArchDoc(docId)   || isCentral() || isAdmin())
        && (!isBranchDoc(docId) || canBranch(branchIdOf(docId)));

      allow write: if isMember()
        && mfaOk()
        && docId != 'admins'
        && knownDoc(docId)
        && validShape(docId)
        && (isChunkDoc(docId) || cvOk(request.resource.data))
        && (!isOrgDoc(docId)    || isAdmin())
        && (!isCoreDoc(docId)   || isCentral() || isAdmin())
        && (!isLegacyDoc(docId) || isCentral() || isAdmin())
        && (!isArchDoc(docId)   || isAdmin())
        && (!isBranchDoc(docId) || canBranch(branchIdOf(docId)))
        && (baseId(docId) != 'rms8_dir' || isAdmin())
        // مستند النبض (الحضور وسجل التدقيق) يكتبه كل عضو نشط؛ غيره ممنوع على أدوار العرض فقط
        && (baseId(docId) == 'rms8_pulse' || isAdmin() || !readOnlyRole());
    }
    /* ===== v28.0 — وحدة تقييم العملاء بالـ QR ===== */
    function validRating(v) { return v is int && v >= 1 && v <= 5; }
    function shortOrNull(v) { return v == null || (v is string && v.size() <= 20); }
    function qrBranchOpen(bId) {
      return bId is string && bId.matches('^[A-Za-z0-9_-]{1,80}$')
        && exists(/databases/$(database)/documents/qr_branches/$(bId))
        && get(/databases/$(database)/documents/qr_branches/$(bId)).data.active == true;
    }

    match /qr_branches/{branchId} {
      allow read: if true;
      allow create, update: if isMember() && (isAdmin() || (isCentral() && !readOnlyRole()))
        && request.resource.data.keys().hasOnly(['name', 'company', 'active', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    match /qr_feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['branchId', 'ratings', 'comment', 'tableNo', 'invoiceNo', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['branchId', 'ratings', 'comment', 'tableNo', 'invoiceNo', 'source', 'createdAt'])
        && qrBranchOpen(request.resource.data.branchId)
        && request.resource.data.ratings is map
        && request.resource.data.ratings.keys().hasOnly(['quality', 'taste', 'temp', 'size', 'staff', 'speed', 'pro', 'clean', 'vibe', 'comfort'])
        && request.resource.data.ratings.keys().hasAll(['quality', 'taste', 'temp', 'size', 'staff', 'speed', 'pro', 'clean', 'vibe', 'comfort'])
        && validRating(request.resource.data.ratings.quality)
        && validRating(request.resource.data.ratings.taste)
        && validRating(request.resource.data.ratings.temp)
        && validRating(request.resource.data.ratings.size)
        && validRating(request.resource.data.ratings.staff)
        && validRating(request.resource.data.ratings.speed)
        && validRating(request.resource.data.ratings.pro)
        && validRating(request.resource.data.ratings.clean)
        && validRating(request.resource.data.ratings.vibe)
        && validRating(request.resource.data.ratings.comfort)
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && shortOrNull(request.resource.data.tableNo)
        && shortOrNull(request.resource.data.invoiceNo)
        && request.resource.data.source == 'qr'
        && request.resource.data.createdAt == request.time;
      allow read: if isMember() && canBranch(resource.data.branchId);
      allow update: if isMember() && canBranch(resource.data.branchId) && !readOnlyRole()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'resolvedAt', 'updatedAt', 'ai', 'aiError'])
        && (!('status' in request.resource.data) || request.resource.data.status in ['new', 'in_progress', 'resolved']);
      allow delete: if isAdmin();
    }
    /* ===== v38.5 — سجل أخطاء الأجهزة المركزي (صيانة النظام) =====
       يكتبه كل عضو نشط باسمه فقط وبحقول محدودة الحجم (لا بيانات تشغيل)، ويقرؤه ويحذفه المسؤول وحده. لا تعديل. */
    function shortStr(v, n) { return v is string && v.size() <= n; }
    match /client_errors/{id} {
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['at', 'msg', 'stack', 'where', 'v', 'role', 'branchId', 'device', 'email', 'sig', 'n'])
        && request.resource.data.keys().hasAll(['at', 'msg', 'v', 'email', 'sig'])
        && request.resource.data.email == userEmail()
        && request.resource.data.at == request.time
        && shortStr(request.resource.data.msg, 400)
        && shortStr(request.resource.data.v, 20)
        && shortStr(request.resource.data.sig, 64)
        && (!('stack' in request.resource.data) || shortStr(request.resource.data.stack, 1500))
        && (!('where' in request.resource.data) || shortStr(request.resource.data.where, 300))
        && (!('role' in request.resource.data) || shortStr(request.resource.data.role, 40))
        && (!('branchId' in request.resource.data) || shortStr(request.resource.data.branchId, 80))
        && (!('device' in request.resource.data) || shortStr(request.resource.data.device, 120))
        && (!('n' in request.resource.data) || (request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 1000));
      allow read, delete: if isAdmin() && mfaOk();
    }

    /* ===== v49.0 — المرحلة 01 (قرار G1-ب): السجلات المالية المستقلة بقواعد تفحص المحتوى =====
       fin_periods/locks: تاريخ إقفال الفترات (يكتبه المدير فقط). fin_journal/{id}: القيد اليدوي سجلًا مستقلًا:
       • الإنشاء: أدوار المحاسبة المركزية فقط، وبتاريخ بعد الإقفال؛ «مرحّل مباشرة» للمدير فقط وإلا «بانتظار الاعتماد».
       • التحديث: انتقال وحيد بانتظار ← مرحّل/مرفوض، بمعتمِد مؤهل غير المنشئ، والمحتوى والبصمة والتاريخ ثابتة، وبعد الإقفال.
       • الحذف: قبل الاعتماد فقط (للمنشئ أو المعتمِد)؛ المرحّل والمرفوض لا يُحذفان — التصحيح بقيد عكسي (يحمل reverses). */
    function finLocksPath() { return /databases/$(database)/documents/fin_periods/locks; }
    function finLockedTo() { return exists(finLocksPath()) ? get(finLocksPath()).data.lockedTo : '0000-00-00'; }
    function finOpen(date) { return date > finLockedTo(); }
    function finRole(m, adm) { return adm || roleOf(m) in ['general_management', 'head_office', 'finance_department', 'accountant']; }
    function finApprover(m, adm) { return adm || roleOf(m) in ['general_management', 'finance_department', 'accountant']; }
    function fjShape(d, id) {
      return d.keys().hasOnly(['date', 'status', 'digest', 'data', 'by', 'at', 'cv', 'reverses', 'decidedBy', 'decidedAt', 'reason', 'legacy', 'origBy'])
        && d.keys().hasAll(['date', 'status', 'digest', 'data', 'by', 'at'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.status in ['pending', 'posted', 'rejected']
        && d.digest is string && d.digest.matches('^[0-9a-f]{64}$')
        && d.data is string && d.data.size() <= 200000
        && d.by is string && (!('reverses' in d) || shortStr(d.reverses, 120))
        && (!('reason' in d) || shortStr(d.reason, 500))
        && cvOk(d) && id.matches('^[A-Za-z0-9_-]{1,120}$');
    }
    function fjCreate(id, d) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && finRole(m, adm) && fjShape(d, id)
        && d.by == userEmail() && d.at == request.time && finOpen(d.date)
        && (d.status == 'pending' || (d.status == 'posted' && adm))
        && !('decidedBy' in d) && !('legacy' in d) && !('origBy' in d);
    }
    /* G4 (قرار المالك): نافذة ترحيل مؤقتة — المدير يفتح fin_periods/migration لمدة أقصاها 24 ساعة، وخلالها فقط ينسخ القيود
       القديمة بحالتها الأصلية (بما فيها المرفوضة) وفي الفترات المقفلة، بعلامة legacy ومنشئها الأصلي. خارج النافذة: لا شيء. */
    function finMigPath() { return /databases/$(database)/documents/fin_periods/migration; }
    function finMigOpen() { return exists(finMigPath()) && finMigLive(get(finMigPath()).data); }
    function finMigLive(g) { return g.open == true && g.until > request.time; }
    function fjLegacy(id, d) {
      let m = memOf();
      let adm = admOf(m);
      return adm && okUser(m, adm) && finMigOpen() && fjShape(d, id)
        && d.legacy == true && d.origBy is string && d.origBy.size() <= 120
        && d.by == userEmail() && d.at == request.time && !('decidedBy' in d);
    }
    function fjUpdate(id, d, o) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && finApprover(m, adm) && fjShape(d, id)
        && o.status == 'pending' && d.status in ['posted', 'rejected']
        && d.date == o.date && d.digest == o.digest && d.data == o.data && d.by == o.by && d.at == o.at
        && (o.by != userEmail() || o.get('legacy', false) == true) && d.decidedBy == userEmail()
        && d.get('legacy', false) == o.get('legacy', false) && d.get('origBy', '') == o.get('origBy', '') && d.decidedAt == request.time
        && finOpen(d.date);
    }
    // حذف القيد قبل اعتماده فقط (كما في التطبيق): لمنشئه أو لمعتمِد مؤهل — المرحّل والمرفوض لا يُحذفان أبدًا
    function fjDelete(o) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && o.status == 'pending'
        && ((finRole(m, adm) && o.by == userEmail()) || finApprover(m, adm))
        // v51.9: «ممنوع» من تعديل القيود (يحدده المسؤول لكل مستخدم) يمنع الحذف هنا أيضًا
        && (adm || !('je' in m.get('editDeny', [])));
    }
    /* v49.0 — المرحلة 01 الخطوة 6: الفواتير والسندات سجلات مستقلة (fin_docs/{kind}_{id}) — kind: pi فاتورة مورد، si فاتورة مبيعات، cv سند.
       • data (محتوى المستند المالي) + digest ثابتان بعد الإنشاء؛ لا يتغير إلا التقدم (prog: السدادات/التحصيلات) ومجموعه paid.
       • الإنشاء بعد تاريخ الإقفال فقط. السند لا يُعدَّل ولا يُحذف. فاتورة المبيعات لا تُحذف (التصحيح بإشعار دائن).
       • فاتورة المورد تُحذف فقط إن لم يُسدَّد منها شيء وفترتها مفتوحة. */
    function fdShape(d, id) {
      return d.keys().hasOnly(['kind', 'date', 'digest', 'data', 'prog', 'paid', 'by', 'at', 'cv', 'updBy', 'updAt', 'legacy'])
        && d.keys().hasAll(['kind', 'date', 'digest', 'data', 'prog', 'paid', 'by', 'at'])
        && d.kind in ['pi', 'si', 'cv'] && id.matches('^(pi|si|cv)_[A-Za-z0-9_-]{1,110}$') && id.split('_')[0] == d.kind
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.digest is string && d.digest.matches('^[0-9a-f]{64}$')
        && d.data is string && d.data.size() <= 300000 && d.prog is string && d.prog.size() <= 200000
        && (d.paid is int || d.paid is float) && d.paid >= 0
        && d.by is string && cvOk(d);
    }
    /* v56.62 (م-2): الكاتب = صلاحية مصدر الحقيقة نفسه (platform/rms8_core: المركزي غير «العرض فقط» أو المدير).
       الفواتير والسندات في CORE_COLS فلا يحفظها جهاز الفرع أصلًا (المستند المركزي لا يُكتب على مسار الفرع)،
       فأي سجل محمي يكتبه عضو فرع (كاشير/مدير فرع/إقليمي) بلا مصدر معتمد ⇒ مرفوض إنشاءً وسدادًا وحذفًا. */
    function fdWriter(m, adm) { return okUser(m, adm) && (adm || (centralOf(m) && roleOf(m) != 'accountant_view')); }
    function fdCreate(id, d) {
      let m = memOf();
      let adm = admOf(m);
      return fdWriter(m, adm) && fdShape(d, id) && d.by == userEmail() && d.at == request.time
        && finOpen(d.date) && !('updBy' in d) && !('legacy' in d);
    }
    function fdLegacy(id, d) {
      let m = memOf();
      let adm = admOf(m);
      return adm && okUser(m, adm) && finMigOpen() && fdShape(d, id)
        && d.legacy == true && d.by == userEmail() && d.at == request.time && !('updBy' in d);
    }
    function fdUpdate(id, d, o) {
      let m = memOf();
      let adm = admOf(m);
      return fdWriter(m, adm) && fdShape(d, id) && o.kind != 'cv'
        && d.kind == o.kind && d.date == o.date && d.digest == o.digest && d.data == o.data && d.by == o.by && d.at == o.at
        && d.get('legacy', false) == o.get('legacy', false)
        && d.updBy == userEmail() && d.updAt == request.time;
    }
    function fdDelete(o) {
      let m = memOf();
      let adm = admOf(m);
      return fdWriter(m, adm) && o.kind == 'pi' && o.paid == 0 && finOpen(o.date)
        && (adm || !('inv' in m.get('editDeny', [])));   // v51.9: «ممنوع» من تعديل الفواتير يمنع حذفها على الخادم
    }
    match /fin_docs/{id} {
      allow read: if (isAdmin() || isCentral()) && mfaOk();
      allow create: if request.resource.data.get('legacy', false) == true ? fdLegacy(id, request.resource.data) : fdCreate(id, request.resource.data);
      allow update: if fdUpdate(id, request.resource.data, resource.data);
      allow delete: if fdDelete(resource.data);
    }
    match /fin_periods/{id} {
      allow read: if isMember() || isAdmin();
      allow create, update: if isAdmin() && mfaOk() && id == 'migration'
        && request.resource.data.keys().hasOnly(['open', 'until', 'by', 'at'])
        && request.resource.data.open is bool && request.resource.data.until is timestamp
        && request.resource.data.until <= request.time + duration.value(24, 'h')
        && request.resource.data.by == userEmail() && request.resource.data.at == request.time;
      allow create, update: if isAdmin() && mfaOk() && id == 'locks'
        && request.resource.data.keys().hasOnly(['lockedTo', 'by', 'at', 'reason'])
        && request.resource.data.lockedTo is string && request.resource.data.lockedTo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.by == userEmail() && request.resource.data.at == request.time
        // فتح فترة مقفلة (تراجع التاريخ) يتطلب سببًا مكتوبًا
        && (resource == null || request.resource.data.lockedTo >= resource.data.lockedTo || (shortStr(request.resource.data.get('reason', ''), 500) && request.resource.data.get('reason', '').size() >= 5));
      allow delete: if false;
    }
    /* v56.9 — MUKTASAB FINANCE D1: دفتر القيود المخزّن (docs/finance/03-PHASE-D-LEDGER-DESIGN.md، قرارات المالك 2026-11-26).
       fin_ledger/{key}: قيد آلي برقم ثابت JV-<السنة>-<تسلسل>، يُنشأ مرة ولا يُعدَّل محتواه ولا يُحذف؛ المجموعان بالهللات متساويان.
       التغيير الوحيد: «مرحّل» ⇒ «معكوس» مع رابط لقيد عكسي يشير إليه، في فترة مفتوحة فقط (لا تصحيح في المقفلة).
       fin_ledger_meta/seq_<السنة>: العدّاد — يزيد بواحد بالضبط في الدفعة نفسها التي يُنشأ فيها القيد (getAfter).
       حد معروف: القواعد لا تجمع سطور القيد (لا حلقات) — تفحص المجموعين المعلنين، والمطابقة مع المحرك تكشف أي فرق. */
    function flDoc(k) { return /databases/$(database)/documents/fin_ledger/$(k); }
    function flSeqPath(y) { return /databases/$(database)/documents/fin_ledger_meta/$('seq_' + string(y)); }
    function flShape(d, id) {
      return d.keys().hasOnly(['no', 'year', 'seq', 'date', 'src', 'title', 'lines', 'drH', 'crH', 'digest', 'ver', 'status', 'reversedBy', 'reversalOf', 'by', 'at', 'cv', 'legacy'])
        && d.keys().hasAll(['no', 'year', 'seq', 'date', 'src', 'lines', 'drH', 'crH', 'digest', 'ver', 'status', 'by', 'at'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.year is int && d.year == int(d.date.split('-')[0])
        && d.seq is int && d.seq >= 1 && d.no is string && d.no.matches('^JV-' + string(d.year) + '-[0-9]{6,9}$')
        && int(d.no.split('-')[2]) == d.seq
        && shortStr(d.src, 200) && (!('title' in d) || shortStr(d.title, 300))
        && d.lines is string && d.lines.size() <= 100000
        && d.drH is int && d.crH is int && d.drH == d.crH && d.drH > 0
        && d.digest is string && d.digest.matches('^[0-9a-f]{64}$')
        && d.ver is int && d.ver >= 1 && d.status in ['posted', 'reversed']
        && (!('reversalOf' in d) || shortStr(d.reversalOf, 150))
        && (!('reversedBy' in d) || shortStr(d.reversedBy, 150))
        && (!('legacy' in d) || d.legacy == true)
        && d.by is string && cvOk(d) && id.matches('^[A-Za-z0-9_-]{1,150}$');
    }
    function flSeqOk(d) {
      let p = flSeqPath(d.year);
      let prev = exists(p) ? get(p).data.n : 0;
      return d.seq == prev + 1 && getAfter(p).data.n == d.seq;
    }
    function flCreate(id, d) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && finRole(m, adm) && flShape(d, id)
        && d.by == userEmail() && d.at == request.time && d.status == 'posted' && !('reversedBy' in d)
        && (d.get('legacy', false) == true ? (adm && finMigOpen()) : finOpen(d.date))
        && flSeqOk(d);
    }
    function flReverse(id, d, o) {
      let m = memOf();
      let adm = admOf(m);
      return okUser(m, adm) && finRole(m, adm) && o.status == 'posted' && d.status == 'reversed'
        && d.diff(o).affectedKeys().hasOnly(['status', 'reversedBy'])
        && shortStr(d.reversedBy, 150) && existsAfter(flDoc(d.reversedBy))
        && getAfter(flDoc(d.reversedBy)).data.get('reversalOf', '') == id
        && finOpen(o.date);
    }
    // العدّاد: {n, last} — n يزيد بواحد، وlast قيد جديد في الدفعة نفسها تسلسله n وسنته سنة العدّاد
    function flMetaOk(id, d, prevN) {
      return id.matches('^seq_[0-9]{4}$') && d.keys().hasOnly(['n', 'last']) && d.n is int && d.n == prevN + 1
        && d.last is string && d.last.matches('^[A-Za-z0-9_-]{1,150}$')
        && !exists(flDoc(d.last)) && existsAfter(flDoc(d.last))
        && getAfter(flDoc(d.last)).data.seq == d.n && getAfter(flDoc(d.last)).data.year == int(id.split('_')[1]);
    }
    // v56.15 (D5 — موافقة المالك): الكتابة من الخادم وحده (حساب الخدمة يتجاوز القواعد، وserver-ledger.js يجمع السطور بالهللات
    // ويتحقق من الدور والفترة ويرقّم في معاملة). المتصفح يقرأ فقط. دوال flCreate/flReverse/flMetaOk أعلاه تبقى توثيقًا لشروط D1
    // التي يطبّقها الخادم الآن بنفسه، ولا تُستدعى.
    match /fin_ledger/{id} {
      allow read: if (isAdmin() || isCentral()) && mfaOk();
      allow create, update, delete: if false;
    }
    match /fin_ledger_meta/{id} {
      allow read: if (isAdmin() || isCentral()) && mfaOk();
      allow create, update, delete: if false;
    }

    match /fin_journal/{id} {
      allow read: if (isAdmin() || isCentral()) && mfaOk();
      allow create: if request.resource.data.get('legacy', false) == true ? fjLegacy(id, request.resource.data) : fjCreate(id, request.resource.data);
      allow update: if fjUpdate(id, request.resource.data, resource.data);
      allow delete: if fjDelete(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
