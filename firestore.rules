rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== المرحلة الأمنية 1 (كما كانت): مصادقة حقيقية + عضوية نشطة =====
    function realUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email != null;
    }
    function userEmail() { return request.auth.token.email.lower(); }

    function memberPath() { return /databases/$(database)/documents/members/$(userEmail()); }

    function isMember() {
      return realUser() && exists(memberPath()) && get(memberPath()).data.active == true;
    }

    function isAdmin() {
      return realUser()
        && exists(/databases/$(database)/documents/platform/admins)
        && (userEmail() in get(/databases/$(database)/documents/platform/admins).data.emails);
    }

    // ===== المرحلة الأمنية 2 (جديدة): عزل الفروع الفعلي + كتم أسرار المنشأة =====
    // سجل العضوية (members/{email}) يحمل منذ v9: role/branchId/branchIds/scope — تُزامَن
    // تلقائياً مع بيانات المستخدمين في org عبر upsertMember (راجع App.jsx/storage.js).
    // scope=='all' يطابق حرفياً ROLES التي عندها scope:'all' في الكود (head_office،
    // system_admin، accountant، accountant_view...)، وهي نفسها التي يقرأ عميلها
    // rms8_org الكامل بدل rms8_dir (راجع ctx.central في App.jsx).
    function memberData() { return get(memberPath()).data; }

    function isCentral() {
      return isMember() && ('scope' in memberData()) && memberData().scope == 'all';
    }
    function myBranchId() {
      return isMember() && ('branchId' in memberData()) ? memberData().branchId : '';
    }
    function myBranchIds() {
      return (isMember() && ('branchIds' in memberData()) && memberData().branchIds is list)
        ? memberData().branchIds : [];
    }
    // أي فرع يملك المستخدم صلاحية الوصول إليه: مدير منصّة أو مركزي (كل الفروع)،
    // أو فرعه المفرد، أو ضمن قائمة فروعه المُسنَدة (مدير إقليمي).
    function canBranch(bId) {
      return isAdmin() || isCentral() || myBranchId() == bId || (bId in myBranchIds());
    }

    // docId تُبنى من المفتاح المنطقي بعد استبدال أي رمز غير حرف/رقم/شرطة بـ"_"
    // (راجع docId() في storage.js)، والمستندات الكبيرة تُقسَّم بلاحقة "__<رقم>".
    // نُسقط لاحقة التقسيم أولاً قبل أي مطابقة.
    function baseId(id) { return id.split('__')[0]; }

    function isOrgDoc(id)    { return baseId(id).matches('^rms8_org.*$'); }
    function isCoreDoc(id)   { return baseId(id) == 'rms8_core'; }
    function isBrDoc(id)     { return baseId(id).matches('^rms8_br_.+$'); }
    function isBfDoc(id)     { return baseId(id).matches('^rms8_bf_.+$'); }
    function isBranchDoc(id) { return isBrDoc(id) || isBfDoc(id); }

    function branchIdOf(id) {
      return isBrDoc(id) ? baseId(id).split('rms8_br_')[1] : baseId(id).split('rms8_bf_')[1];
    }

    // سجل تدقيق rms8_pulse لا يُقلَّص/يُمسَح من غير مدير (يمنع إخفاء الأثر) — v9.1،
    // مطبَّق هنا خادمياً وليس فقط اعتماداً على انضباط العميل.
    function pulseAuditSafe() {
      return isAdmin()
        || !('audit' in resource.data)
        || !('audit' in request.resource.data)
        || request.resource.data.audit.size() >= resource.data.audit.size();
    }

    match /platform/admins {
      allow read: if realUser();
      allow create: if realUser() && request.resource.data.emails == [userEmail()];
      allow update, delete: if isAdmin();
    }

    match /members/{memberEmail} {
      allow read: if isAdmin() || (realUser() && userEmail() == memberEmail);
      allow write: if isAdmin();
    }

    match /platform/{docId} {
      // rms8_org* — أسرار المنشأة كاملة (كلمات مرور مشفّرة، رواتب، إعدادات): القراءة
      // للمركزيين/المدراء فقط (تطابق ما يفعله العميل فعلياً: الفرعي يقرأ dir لا org).
      // rms8_core — بيانات تشغيل مركزية: للمركزيين/المدراء فقط.
      // rms8_br_*/rms8_bf_* — بيانات فرع بعينه: لأصحاب ذلك الفرع أو المركزيين/المدراء فقط.
      // غير ذلك (rms8_dir/rms8_ops/rms8_pulse/rms8_hist/rms8_files وغيرها) كما كانت:
      // أي عضو نشط.
      allow read: if isMember()
        && (!isOrgDoc(docId)    || isCentral() || isAdmin())
        && (!isCoreDoc(docId)   || isCentral() || isAdmin())
        && (!isBranchDoc(docId) || canBranch(branchIdOf(docId)));

      allow write: if isMember()
        && (!isOrgDoc(docId)    || isAdmin())
        && (!isCoreDoc(docId)   || isCentral() || isAdmin())
        && (!isBranchDoc(docId) || canBranch(branchIdOf(docId)))
        // rms8_dir دليل مشتق تلقائياً من org — يكتبه المدراء فقط (ضمن مسار حفظ org نفسه)
        && (docId != 'rms8_dir' || isAdmin())
        && (docId != 'rms8_pulse' || pulseAuditSafe());
    }

    // امنع أي مسار آخر
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
