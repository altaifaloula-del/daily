# ============ الذكاء المالي (خادم فقط — لا يصل المتصفح) ============
# لا تضع مفتاح Anthropic أبدًا في متغير يبدأ بـ VITE_ — كل ما يبدأ بـ VITE_ يُدمج في حزمة المتصفح ويصبح علنيًا.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high — مستوى عمق التحليل (الافتراضي medium)
AI_EFFORT=medium
AI_RATE_LIMIT_PER_HOUR=30
# v56.59: حد المنشأة مجتمعة لكل ساعة على التحليل المالي وتحليل التعليقات ومساعد النمو (مشترك بين الثلاثة)، وحد لكل عنوان IP قبل التحقق من الهوية (كل 10 دقائق)
AI_TENANT_PER_HOUR=120
AI_IP_PER_10MIN=120
# v56.55 قراءة فاتورة المورد بالذكاء الاصطناعي (POST /api/ai/invoice-read) — حد مستقل لكل مستخدم في الساعة (الافتراضي 60)
AI_INVREAD_RATE_PER_HOUR=60
# وحد المنشأة مجتمعة لقراءة الفواتير في الساعة (الافتراضي 200)
AI_INVREAD_TENANT_PER_HOUR=200
PORT=8787
# أصول الواجهة المسموح لها باستدعاء الخادم من نطاق آخر (مثل GitHub Pages)، مفصولة بفواصل
ALLOWED_ORIGINS=https://altaifaloula-del.github.io
# يتحقق الخادم من رمز الدخول وعضوية المستخدم عبر Firebase (تُقبل أيضًا قيم VITE_FIREBASE_* أدناه)
FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID=   (اختياري — يُستنتج من رمز الدخول؛ إن ضُبط يجب أن يطابقه)
# تخزين /api/store بلا مصادقة — للتطوير المحلي فقط؛ مُعطّل تلقائيًا في الإنتاج وعند ضبط Firebase
# ENABLE_STORE_API=1
# عنوان الموقع الذي يُرسل لـ Google مع التحقق من الرمز (يُشتق من أول ALLOWED_ORIGINS إن تُرك)
# FIREBASE_REFERER=https://altaifaloula-del.github.io/

# ============ الفوترة الإلكترونية (خادم فقط) ============
# مفتاح تشفير أسرار أجهزة الإصدار (AES-256-GCM) — 32 حرفًا على الأقل، عشوائي، لا يُغيَّر بعد أول تسجيل جهاز
# (تغييره يجعل الأسرار المشفّرة سابقًا غير قابلة للفك). توليده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZATCA_ENC_KEY=
# v56.0 (BUG-012): احفظ نسخة من المفتاح في خزنة المالك خارج منصة الاستضافة. بصمته (ليست سرًا) يطبعها سجل الإقلاع:
# ثبّتها هنا ليحذّر الخادم فورًا إن تغيّر المفتاح (إعادة إنشاء الخدمة، نسخ إعدادات خاطئة).
ZATCA_KEY_ID=

# ============ الواجهة: رابط وسيط الذكاء (اختياري) ============
# VITE_AI_ENDPOINT=https://your-server.example.com/api/ai/analyze
# رابط تحليل تعليقات QR — يُشتق تلقائيًا من السابق (/api/ai/feedback) إن تُرك
# VITE_AI_FEEDBACK_ENDPOINT=

# ============ الإشعارات الفورية (Firebase Cloud Messaging) ============
# المفتاح العام (VAPID) من Firebase Console ← Project settings ← Cloud Messaging ← Web Push certificates
# مفتاح عام بطبيعته ويُسمح بدمجه في الواجهة. فارغ = الإشعارات معطّلة
VITE_FCM_VAPID_KEY=

# ============ Firestore (اتركها فارغة لاستخدام خادم المشروع بدلاً منها) ============
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_COLLECTION=platform

# ============ سكربتات GitHub Actions (تُضبط في GitHub Secrets لا هنا) ============
# FIREBASE_SERVICE_ACCOUNT — ملف JSON لحساب الخدمة (نسخ احتياطي، إشعارات، نشر القواعد، MFA)
# BACKUP_KEY — كلمة سر تشفير النسخ الاحتياطية الليلية (احفظها خارج GitHub؛ فقدها = فقد القدرة على الاستعادة)

# ============ v56.50 إرسال الرسائل للعملاء (خادم فقط — لا يصل المتصفح) ============
# المحوّل: dryrun (الافتراضي — لا يرسل شيئًا). محوّل المزوّد الحقيقي يُضاف لاحقًا بمفتاحه في متغير خاص به هنا.
COMMS_ADAPTER=dryrun
# مفتاح بصمات المستلمين للحد الشهري (HMAC-SHA256) — قيمة عشوائية طويلة؛ إلزامي للإرسال الفعلي. لا تضع القيمة في المستودع.
# يجب أن يبقى ثابتًا: تدويره يغيّر البصمات فيصفّر عدّاد الحد الشهري للشهر الجاري (رسائل الشهر السابقة للتدوير لا تُحتسب بعده).
COMMS_HMAC_KEY=
