# ============ الذكاء المالي (خادم فقط — لا يصل المتصفح) ============
# لا تضع مفتاح Anthropic أبدًا في متغير يبدأ بـ VITE_ — كل ما يبدأ بـ VITE_ يُدمج في حزمة المتصفح ويصبح علنيًا.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high — مستوى عمق التحليل (الافتراضي medium)
AI_EFFORT=medium
AI_RATE_LIMIT_PER_HOUR=30
PORT=8787
# أصول الواجهة المسموح لها باستدعاء الخادم من نطاق آخر (مثل GitHub Pages)، مفصولة بفواصل
ALLOWED_ORIGINS=https://altaifaloula-del.github.io
# يتحقق الخادم من رمز الدخول وعضوية المستخدم عبر Firebase (تُقبل أيضًا قيم VITE_FIREBASE_* أدناه)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# تخزين /api/store بلا مصادقة — للتطوير المحلي فقط؛ مُعطّل تلقائيًا في الإنتاج وعند ضبط Firebase
# ENABLE_STORE_API=1

# ============ الواجهة: رابط وسيط الذكاء (اختياري) ============
# VITE_AI_ENDPOINT=https://your-server.example.com/api/ai/analyze

# ============ Firestore (اتركها فارغة لاستخدام خادم المشروع بدلاً منها) ============
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_COLLECTION=platform
