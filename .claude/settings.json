{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/service-account*.json)",
      "Read(**/*-firebase-adminsdk-*.json)",
      "Read(./data/**)",
      "Read(./backups/**)",
      "Edit(./docs/approvals/granted/**)",
      "Write(./docs/approvals/granted/**)",
      "Edit(./tests/ai-team/brand-baseline.json)",
      "Write(./tests/ai-team/brand-baseline.json)",
      "Edit(./public/brand/**)",
      "Write(./public/brand/**)",
      "Edit(./brand/**)",
      "Write(./brand/**)",
      "Bash(firebase deploy *)",
      "Bash(npx firebase deploy *)",
      "Bash(npx firebase-tools *)",
      "Bash(npx --yes firebase-tools *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(gh workflow run *)",
      "Bash(node scripts/nightly-backup.mjs *)",
      "Bash(node scripts/push-alerts.mjs *)",
      "Bash(node scripts/enable-totp.mjs *)",
      "Bash(node scripts/tenant-provision.mjs *)",
      "Bash(node scripts/billing-admin.mjs *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr create *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(npm ci)",
      "Bash(npm uninstall *)",
      "Bash(npm run zatca:sandbox *)",
      "Bash(npm run zatca:sandbox)",
      "Edit(./firestore.rules)",
      "Edit(./firestore.tenant.rules)",
      "Edit(./firestore.control.rules)",
      "Edit(./firestore.indexes.json)",
      "Edit(./.github/workflows/**)",
      "Edit(./package.json)",
      "Edit(./scripts/quality-gate.mjs)",
      "Edit(./tests/validation/**)"
    ],
    "allow": [
      "Bash(node --test *)",
      "Bash(node scripts/quality-gate.mjs *)",
      "Bash(node scripts/quality-gate.mjs)",
      "Bash(node tests/ai-team/design-lint.mjs *)",
      "Bash(node tests/ai-team/design-lint.mjs)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run test:acct)",
      "Bash(npm run test:zatca)",
      "Bash(npm run test:rules)",
      "Bash(npm run test:ui)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  }
}
