rules_version = '2';
// v51.4 — مشروع تحكم مِثقال (سجل الفوترة والاشتراكات): لا وصول من أي متصفح أو حساب مستخدم.
// خادم مِثقال وأدوات المزوّد يصلان بحساب خدمة (يتجاوز هذه القواعد بصلاحيات IAM).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
